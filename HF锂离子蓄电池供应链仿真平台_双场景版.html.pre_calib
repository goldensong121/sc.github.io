            '<p>从电芯采购到PACK交付，全链路60天动态仿真</p></div></div>' +
          '</div>' +
          '<h3 style="margin:1.2rem 0 0.6rem; color:var(--theme);"><i class="fas fa-video"></i> 平台讲解视频</h3>' +
          '<div style="border-radius:1rem; overflow:hidden; box-shadow:0 4px 15px rgba(0,0,0,0.1);">' +
            '<iframe src="https://player.bilibili.com/player.html?isOutside=true&aid=116883978191815&bvid=BV1K2Mg6cEnP&cid=39762330985&p=1&high_quality=1&autoplay=0" ' +
            'style="width:100%; height:450px; border:none;" allowfullscreen="true" scrolling="no"></iframe>' +
          '</div>' +
          '<p style="margin:1rem 0; line-height:1.8; color:#5a6c7d;">您将扮演供应链运营总监，在以下11个环节中完成关键决策：</p>' +
          '<div class="flex-row">' +
            '<div class="card"><i class="fas fa-database" style="color:#00d2ff;"></i> <strong>数据认知</strong><p style="font-size:0.8rem; color:#6c7a89;">销售网点、供应商基础数据</p></div>' +
            '<div class="card"><i class="fas fa-brain" style="color:#ffaa00;"></i> <strong>知识小测</strong><p style="font-size:0.8rem; color:#6c7a89;">供应链基础知识检验</p></div>' +
            '<div class="card"><i class="fas fa-chart-line" style="color:#00ff88;"></i> <strong>需求预测</strong><p style="font-size:0.8rem; color:#6c7a89;">基于历史数据预测60天需求</p></div>' +
            '<div class="card"><i class="fas fa-industry" style="color:#ff6688;"></i> <strong>生产计划</strong><p style="font-size:0.8rem; color:#6c7a89;">分配广州苏州工厂产能</p></div>' +
          '</div>' +
          '<div class="flex-row" style="margin-top:0.8rem;">' +
            '<div class="card"><i class="fas fa-cubes" style="color:#aa88ff;"></i> <strong>BOM物料</strong><p style="font-size:0.8rem; color:#6c7a89;">电芯、电解液、壳体需求</p></div>' +
            '<div class="card"><i class="fas fa-truck" style="color:#00ccff;"></i> <strong>采购物流</strong><p style="font-size:0.8rem; color:#6c7a89;">供应商选择与路线规划</p></div>' +
            '<div class="card"><i class="fas fa-vr-cardboard" style="color:#00ff88;"></i> <strong>孪生模拟</strong><p style="font-size:0.8rem; color:#6c7a89;">60天动态运行3D可视化</p></div>' +
            '<div class="card"><i class="fas fa-trophy" style="color:#ffaa00;"></i> <strong>成绩复盘</strong><p style="font-size:0.8rem; color:#6c7a89;">五维评分与优化建议</p></div>' +
          '</div>' +
          '<div class="kpi-row">' +
            '<div class="kpi"><div class="k-label"><i class="fas fa-clock"></i>仿真周期</div><div class="k-value">60<em>天</em></div></div>' +
            '<div class="kpi"><div class="k-label"><i class="fas fa-industry"></i>PACK 工厂</div><div class="k-value">2<em>家 · 日产 3,193 套</em></div></div>' +
            '<div class="kpi"><div class="k-label"><i class="fas fa-store"></i>原料供应商</div><div class="k-value">6<em>家 · 电芯/电解液/壳体</em></div></div>' +
            '<div class="kpi"><div class="k-label"><i class="fas fa-users"></i>销售网点</div><div class="k-value">4<em>个 · 覆盖中日</em></div></div>' +
            '<div class="kpi"><div class="k-label"><i class="fas fa-route"></i>运输路线</div><div class="k-value">18<em>条 · 汽运/铁路/海运</em></div></div>' +
          '</div>' +
          '<h3 style="margin:1.2rem 0 0.6rem; color:var(--theme);"><i class="fas fa-lightbulb"></i> 锂离子电池核心概念（点击卡片翻转）</h3>' +
          '<div class="flip-grid">' + hfConcepts().map(function(c, i){
            return '<div class="flip" data-i="' + i + '"><div class="flip-inner">' +
              '<div class="flip-face flip-front"><div class="f-ic"><i class="fas ' + c.ic + '"></i></div>' +
              '<div class="f-t">' + c.t + '</div><div class="f-s">' + c.s + '</div>' +
              '<div class="flip-hint">翻转 ⟳</div></div>' +
              '<div class="flip-face flip-back">' + c.b + '</div></div></div>';
          }).join('') + '</div>' +
          '<button class="primary" onclick="window._nav(2)"><i class="fas fa-play"></i> 开始实验 →</button>';
        break;

      case 2: {
        let pts = MASTER_DATA.salesPoints.map(p =>
          '<tr><td>'+p.id+'</td><td>'+p.inventory+'套</td><td>'+p.history.join(', ')+'</td><td><strong>'+p.forecast+'套</strong></td><td>'+p.cap+'套</td></tr>'
        ).join('');
        let sup = MASTER_DATA.suppliers.map(s =>
          '<tr><td>'+s.id+'</td><td>'+s.material+'</td><td>'+s.available+'</td><td>'+s.price+' '+s.currency+'</td></tr>'
        ).join('');
        var criteria = [
          { t:'采购成本 · 25分', s:'单位采购成本 vs 基准 ¥236/套', b:'公式：<b>（总采购费＋总原料运输费＋堆存费＋超限费）÷ 总实际产出量</b>。优先低价供应商可显著提分；原料短缺会同步拖累产出。' },
          { t:'物流成本 · 25分', s:'单位物流成本 vs 基准 ¥45/套', b:'公式：<b>（总产品运输成本＋堆存费＋超限费）÷ 总实际销售量</b>。海运／铁路单位成本更低，跨境日本总代尤为明显。' },
          { t:'市场满足率 · 20分', s:'实际销售 ÷ 实际需求', b:'产出与运输能力共同决定能交付多少。跨周期运输要考虑<b>在途时间</b>，临近期末才发货会降低满足率。' },
          { t:'生产满足率 · 15分', s:'实际产出 ÷ 计划产出', b:'受<b>原料可供量</b>与<b>良品率</b>约束。只选一家小供应商可能导致断供，计划产量落空。' },
          { t:'预测偏差 · 15分', s:'|预测量−实际需求| ÷ 实际需求', b:'实际需求按<b>历史月均</b>估算。偏差 40% 以上得 0 分，逼近真实规律是核心提分点。' }
        ];
        html = '<h2><i class="fas fa-book-open"></i> 步骤2：案例数据认知</h2>' +
          '<div class="supply-hero" style="height:180px;">' +
            '<img src="assets/factory-line.jpg" alt="锂离子电池PACK生产线">' +
            '<div class="hero-overlay"><div><h3>智能化锂离子电池PACK生产车间</h3>' +
            '<p>电芯模组自动装配，日产能超3000套</p></div></div>' +
          '</div>' +

          '<details style="background:#f8fafc; border:1px solid #dce4ec; border-radius:0.8rem; padding:0.8rem; margin:1rem 0;" open>' +
            '<summary style="cursor:pointer; font-weight:600; color:var(--theme); font-size:1rem;"><i class="fas fa-info-circle"></i> 实验背景介绍</summary>' +
            '<div style="margin-top:0.8rem; line-height:1.9; color:#2c3e50; font-size:0.9rem;">' +
              '<p><strong>HF公司</strong>是专业锂离子蓄电池生产企业，产品广泛应用于<strong>新能源汽车</strong>与<strong>工业无人机</strong>两大领域：车载PACK配套纯电/混动乘用车与物流车，无人机PACK配套植保无人机、巡检无人机与测绘无人机。主流技术路线为磷酸铁锂（车载长寿命场景）与三元锂（无人机高能量密度场景）。业务覆盖电芯、电解液、结构壳体采购，电池模组与PACK集成生产，成品国内配送与跨境海运。本仿真通过需求预测、采购订单、生产计划、物流运输模拟，学习锂离子蓄电池双场景供应链运营决策，仿真周期为<strong>60天</strong>。</p>' +
              '<p style="margin-top:0.5rem;"><strong>电池结构层级：</strong>电芯（内部正极、负极、隔膜、电解液、壳体五大件）→ 模组（电芯串并联+绝缘支架+汇流排+NTC+采集线束）→ CTP/CTC（电芯直排入包/底盘）→ PACK（电芯阵列+BMS+热管理+高压继电器+铝合金托盘，是交付整车的完整高压系统）。本仿真产品分两类交付成品：<strong>车载电池PACK</strong>（交付整车厂）与<strong>无人机电池PACK</strong>（交付无人机整机厂），均由电芯×2组、电解液×0.1桶、壳体×1个装配而成，每套由电芯×2组、电解液×0.1桶、壳体×1个装配而成。</p>' +
              '<p style="margin-top:0.5rem;"><strong>总分评分标准：</strong>总分 = 单位采购成本分 + 单位物流成本分 + 市场满足率分 + 生产满足率分 + 预测偏差率分</p>' +
              '<ul style="margin-top:0.3rem; padding-left:1.5rem;">' +
                '<li>单位采购成本 =（总采购费+总原料运输费+堆存费+超限费）/ 总实际产出量</li>' +
                '<li>单位物流成本 =（总产品运输成本+堆存费+超限费）/ 总实际销售量</li>' +
                '<li>市场满足率 = 总实际销售量 / 总市场需求量</li>' +
                '<li>生产满足率 = 总实际产出量 / 总计划产出量</li>' +
                '<li>预测偏差率 = Σ(|网点预测量-网点实际需求|/网点实际需求) ÷ 网点数</li>' +
              '</ul>' +
              '<p style="margin-top:0.5rem;"><strong>核心注意事项：</strong>多销售网点需求预测、多原料多供应商采购（电芯/电解液/壳体）、跨境多式联运物流、库存上限超限收费、多币种汇率结算。</p>' +
            '</div>' +
          '</details>' +

          '<details style="background:#f8fafc; border:1px solid #dce4ec; border-radius:0.8rem; padding:0.8rem; margin:0 0 1rem 0;">' +
            '<summary style="cursor:pointer; font-weight:600; color:var(--theme); font-size:1rem;"><i class="fas fa-clipboard-list"></i> HF锂离子蓄电池操作手册 V1.0（点击展开）</summary>' +
            '<div style="margin-top:0.8rem; line-height:1.9; color:#2c3e50; font-size:0.88rem;">' +
              '<p><strong>1. 系统概述：</strong>本平台为《HF锂离子蓄电池 · 3D数字孪生供应链虚拟仿真实验》，基于Three.js构建3D可视化场景，模拟锂离子蓄电池PACK（新能源汽车车载版+工业无人机版）从电芯采购、模组集成、PACK装配、物流配送到客户交付的完整供应链流程。用户扮演供应链管理者，在11个步骤中完成决策，通过60天模拟运行获得综合评分。</p>' +
              '<p style="margin-top:0.4rem;"><strong>2. 环境要求：</strong>推荐最新版Chrome/Edge浏览器，需联网加载CDN资源，建议分辨率≥1366×768。</p>' +
              '<p style="margin-top:0.4rem;"><strong>3. 登录：</strong>用户名 <code style="background:#eef4fb;padding:0.1rem 0.4rem;border-radius:0.3rem;">HFAdmin</code> / 密码 <code style="background:#eef4fb;padding:0.1rem 0.4rem;border-radius:0.3rem;">supply2024</code>，点击"进入仿真实验"。</p>' +
              '<p style="margin-top:0.4rem;"><strong>4. 实验流程（11步）：</strong></p>' +
              '<ol style="padding-left:1.5rem;">' +
                '<li><strong>步骤1 欢迎：</strong>观看B站讲解视频，了解平台功能，点击"开始实验"。</li>' +
                '<li><strong>步骤2 案例数据：</strong>阅读实验背景、本操作手册，浏览销售网点、供应商、评分标准表格，勾选"我已阅读"。</li>' +
                '<li><strong>步骤3 知识小测：</strong>完成3道锂电池结构基础题，选择答案后立即反馈对错。</li>' +
                '<li><strong>步骤4 需求预测：</strong>拖动滑块调整4个网点的60天预测量；下方选择市场投标策略（保守/均衡/激进）。</li>' +
                '<li><strong>步骤5 生产补货：</strong>在广州、苏州两PACK厂分配计划产量；可选工厂扩建（产能+20%）和融资贷款（30/90/180天）。</li>' +
                '<li><strong>步骤6 物料BOM：</strong>查看电芯×2组、电解液×0.1桶、壳体×1个需求，可手动微调考虑损耗。</li>' +
                '<li><strong>步骤7 供应商选择：</strong>点击卡片多选供应商（电芯/电解液/壳体），需覆盖三种物料，支持AI选最低价。</li>' +
                '<li><strong>步骤8 物流计划：</strong>选择路线，调整运输天数和运输量，自动算到达日期；支持AI自动规划。</li>' +
                '<li><strong>步骤9 数字孪生：</strong>调节外部参数，运行60天模拟，过程中会弹出7个风险事件选择框（电芯限产、汇率波动、需求超预期、海运延误、良品率下降、暴雪封路、油价上涨）。</li>' +
                '<li><strong>步骤10 成绩：</strong>查看五维评分、五维运营考核指标（净资产/市场占有率/库存周转率/准时交货率/现金流），导出Excel。</li>' +
                '<li><strong>步骤11 复盘分析：</strong>查看桑基图、关键数字、AI优化建议，记录复盘笔记。</li>' +
              '</ol>' +
              '<p style="margin-top:0.4rem;"><strong>5. 评分标准：</strong>总分100 = 采购成本(25) + 物流成本(25) + 市场满足率(20) + 生产满足率(15) + 预测偏差(15)。</p>' +
              '<p style="margin-top:0.4rem;"><strong>6. 常见问题：</strong></p>' +
              '<ul style="padding-left:1.5rem;">' +
                '<li>无法下一步：请检查当前步骤必填项（滑块已保存、卡片已选择、复选框已勾选）。</li>' +
                '<li>成绩记录：存储在浏览器本地LocalStorage，清除缓存会丢失，建议定期导出Excel备份。</li>' +
                '<li>页面显示异常：按Ctrl+F5强制刷新，或换Chrome/Edge浏览器。</li>' +
                '<li>风险事件弹窗：运行模拟后会自动弹出，请依次做出选择，共7次。</li>' +
              '</ul>' +
            '</div>' +
          '</details>' +

          '<h3><i class="fas fa-store"></i> 销售网点信息</h3>' +
          '<table><thead><tr><th>网点</th><th>期初库存</th><th>近6月历史销量</th><th>初始预测</th><th>库存上限</th></tr></thead><tbody>'+pts+'</tbody></table>' +
          '<h3 style="margin-top:1rem;"><i class="fas fa-truck"></i> 供应商信息</h3>' +
          '<table><thead><tr><th>供应商</th><th>物料</th><th>可供货量</th><th>单价</th></tr></thead><tbody>'+sup+'</tbody></table>' +
          '<h3 style="margin-top:1.2rem;"><i class="fas fa-star" style="color:#00d2ff;"></i> 评分标准（点击卡片翻转）</h3>' +
          '<div class="flip-grid">' + criteria.map(function(c, i){
            return '<div class="flip" data-i="' + i + '"><div class="flip-inner">' +
              '<div class="flip-face flip-front"><div class="f-ic"><i class="fas fa-bullseye"></i></div>' +
              '<div class="f-t">' + c.t + '</div><div class="f-s">' + c.s + '</div>' +
              '<div class="flip-hint">翻转 ⟳</div></div>' +
              '<div class="flip-face flip-back">' + c.b + '</div></div></div>';
          }).join('') + '</div>' +
          '<label style="display:block; margin-top:1rem; cursor:pointer;"><input type="checkbox" id="understandData"> 我已阅读并理解实验数据与评分标准</label>' +
          '<button class="primary" id="confirmStep2">确认，进入知识小测 →</button>';
        break;
      }

      case 3: {
        // 新增：知识小测环节
        html = '<h2><i class="fas fa-brain"></i> 步骤3：供应链知识小测</h2>' +
          '<p style="color:#6c7a89; margin-bottom:1rem;">完成以下3道选择题，检验您对供应链基础知识的掌握程度。</p>' +
          '<div id="quizContainer"></div>' +
          '<div id="quizResult" class="hidden" style="margin-top:1rem;"></div>' +
          '<button class="primary hidden" id="submitQuizBtn">提交答案</button>' +
          '<button class="secondary hidden" id="nextAfterQuizBtn">完成小测，进入需求预测 →</button>';
        break;
      }

      case 4: {
        let sliders = MASTER_DATA.salesPoints.map(p =>
          '<div class="card interactive"><h4>'+p.id+'</h4>' +
          '<p style="font-size:0.8rem; color:#6c7a89;">历史月均：'+Math.round(p.history.reduce((a,b)=>a+b,0)/6)+'套</p>' +
          '<div class="slider-group"><label>预测量：<span id="'+p.id+'_val" style="color:#00ff88; font-weight:bold;">'+state.demandForecast[p.id]+'</span> 套</label>' +
          '<input type="range" id="'+p.id+'_slider" min="10000" max="40000" value="'+state.demandForecast[p.id]+'" step="100"></div>' +
          '<div class="progress-bar"><div class="progress-fill" style="width:'+(state.demandForecast[p.id]/40000*100)+'%"></div></div></div>'
        ).join('');
        html = '<h2><i class="fas fa-chart-line"></i> 步骤4：需求预测</h2>' +
          '<p style="color:#6c7a89;">根据各销售网点近6个月历史销量，调整未来60天需求预测量。</p>' +
          '<div class="flex-row">'+sliders+'</div>' +
          '<div id="demandChart" style="height:280px; width:100%; margin-top:1rem;"></div>' +
          '<button class="primary" id="saveForecast"><i class="fas fa-save"></i> 保存预测</button>' +
          '<button class="secondary" id="resetForecast">恢复默认值</button>' +
          '<button class="secondary" id="aiForecast" style="border-color:#9b59b6;color:#9b59b6;"><i class="fas fa-robot"></i> AI智能填充</button>' +
          '<div class="card" style="margin-top:1.2rem; border-left:4px solid #e67e22;">' +
            '<h4><i class="fas fa-gavel" style="color:#e67e22;"></i> V3.0 新增：市场投标策略</h4>' +
            '<p style="font-size:0.88rem; color:#5a6c7d; line-height:1.7; margin:0.5rem 0;">客户发布招标需求，你需要决定投标报价。投标价过高会丢标，过低则利润受损。系统按<b>交付能力(40%)+投标价格(40%)+企业信用(20%)</b>打分。</p>' +
            '<div style="display:grid; grid-template-columns:repeat(3,1fr); gap:0.8rem; margin-top:0.8rem;">' +
              '<div style="background:#fef5e7; border:2px solid #f5cba7; border-radius:0.6rem; padding:0.8rem; cursor:pointer;" onclick="selectBid(this,0)">' +
                '<div style="font-weight:700; color:#d35400;">保守投标</div>' +
                '<div style="font-size:0.8rem; color:#7b3f00; margin-top:0.3rem;">报价：420元/套<br>中标率：65%<br>利润率：高</div>' +
              '</div>' +
              '<div style="background:#eafaf1; border:2px solid #a9dfbf; border-radius:0.6rem; padding:0.8rem; cursor:pointer;" onclick="selectBid(this,1)">' +
                '<div style="font-weight:700; color:#1e8449;">均衡投标</div>' +
                '<div style="font-size:0.8rem; color:#145a32; margin-top:0.3rem;">报价：395元/套<br>中标率：82%<br>利润率：中</div>' +
              '</div>' +
              '<div style="background:#fdedec; border:2px solid #f5b7b1; border-radius:0.6rem; padding:0.8rem; cursor:pointer;" onclick="selectBid(this,2)">' +
                '<div style="font-weight:700; color:#c0392b;">激进投标</div>' +
                '<div style="font-size:0.8rem; color:#7b241c; margin-top:0.3rem;">报价：370元/套<br>中标率：95%<br>利润率：低</div>' +
              '</div>' +
            '</div>' +
            '<p style="font-size:0.82rem; color:#95a5a6; margin-top:0.6rem;"><i class="fas fa-info-circle"></i> 投标需支付保证金（招标数量×投标价×1%），未中标开标日返还。</p>' +
          '</div>';
        break;
      }

      case 5: {
        let totalDemand = Object.values(state.demandForecast).reduce((a,b)=>a+b,0);
        let facs = MASTER_DATA.factories.production.map(f =>
          '<div class="card interactive"><h4><i class="fas fa-industry"></i> '+f.factory+'</h4>' +
          '<p style="font-size:0.85rem;">日产能：<strong style="color:#00d2ff;">'+f.daily+'套</strong> | 库存：'+f.stock+'套</p>' +
          '<p style="font-size:0.85rem;">60天最大产能：<strong style="color:#00ff88;">'+f.total+'套</strong></p>' +
          '<label style="margin-top:0.5rem; display:block;">计划产量：<input type="number" id="'+f.factory+'_prod" value="'+(state.productionPlan[f.factory]||f.total)+'" min="0" max="'+f.total+'" step="100"></label></div>'
        ).join('');
        html = '<h2><i class="fas fa-industry"></i> 步骤5：生产补货计划</h2>' +
          '<div class="card" style="margin-bottom:1rem; text-align:center;">' +
            '<h4>总需求预测</h4><span class="value">'+totalDemand.toLocaleString()+'</span> <span style="color:#6c7a89; font-size:0.9rem;">套</span></div>' +
          '<div class="flex-row">'+facs+'</div>' +
          '<div class="map3d-card" id="factoryScene3d" style="height:240px;"><div class="scene-badge"><i class="fas fa-cog"></i> 3D 工厂产线 · 实时反映计划产量</div><div class="scene-tip">拖拽旋转查看</div></div>' +
          '<div id="replenishmentDisplay" style="margin-top:1rem;"></div>' +
          '<button class="secondary" id="autoProd" style="border-color:#9b59b6;color:#9b59b6;"><i class="fas fa-robot"></i> 按产能自动分配</button>' +
          '<div class="card" style="margin-top:1rem; border-left:4px solid #8e44ad;">' +
            '<h4><i class="fas fa-building" style="color:#8e44ad;"></i> V3.0 新增：工厂扩建与融资贷款</h4>' +
            '<p style="font-size:0.88rem; color:#5a6c7d; line-height:1.7; margin:0.5rem 0;">初始资金2000万。如需扩大产能或补充流动资金，可向金融机构抵押贷款。固定资产（工厂/仓库）可抵押60%价值贷款。</p>' +
            '<div id="upgradeCard" style="background:#f4ecf7; border:2px solid #d2b4de; border-radius:0.6rem; padding:0.8rem; margin-top:0.5rem; cursor:pointer;" onclick="toggleUpgrade(this)">' +
              '<div style="font-weight:700; color:#6c3483;">扩建苏州工厂（中型→大型）</div>' +
              '<div style="font-size:0.82rem; color:#512e5f; margin-top:0.3rem;">投资800万 | 产能+20% | 建设周期7天 | 日管理成本+1.1万</div>' +
            '</div>' +
            '<div style="margin-top:0.8rem; font-weight:600; color:#2c3e50;">选择贷款周期（企业信用等级：良好，利率基准）：</div>' +
            '<div style="display:grid; grid-template-columns:repeat(3,1fr); gap:0.8rem; margin-top:0.5rem;">' +
              '<div style="background:#eaf2f8; border:2px solid #aed6f1; border-radius:0.6rem; padding:0.8rem; cursor:pointer;" onclick="selectLoan(this,30)">' +
                '<div style="font-weight:700; color:#21618c;">30天（一期）</div>' +
                '<div style="font-size:0.8rem; color:#1a5276; margin-top:0.3rem;">利率1.7%/期<br>最高贷500万</div>' +
              '</div>' +
              '<div style="background:#eaf2f8; border:2px solid #aed6f1; border-radius:0.6rem; padding:0.8rem; cursor:pointer;" onclick="selectLoan(this,90)">' +
                '<div style="font-weight:700; color:#21618c;">90天（三期）</div>' +
                '<div style="font-size:0.8rem; color:#1a5276; margin-top:0.3rem;">利率1.9%/期<br>最高贷1000万</div>' +
              '</div>' +
              '<div style="background:#eaf2f8; border:2px solid #aed6f1; border-radius:0.6rem; padding:0.8rem; cursor:pointer;" onclick="selectLoan(this,180)">' +
                '<div style="font-weight:700; color:#21618c;">180天（六期）</div>' +
                '<div style="font-size:0.8rem; color:#1a5276; margin-top:0.3rem;">利率2.1%/期<br>最高贷1500万</div>' +
              '</div>' +
            '</div>' +
            '<p style="font-size:0.82rem; color:#95a5a6; margin-top:0.6rem;"><i class="fas fa-exclamation-triangle" style="color:#e74c3c;"></i> 注意：贷款超期15天未还，工厂/仓库将被银行罚没清算；现金流为负即破产。</p>' +
          '</div>' +
          '<button class="primary" id="confirmProduction">确认生产计划 →</button>';
        break;
      }

      case 6: {
        let totalProd = Object.values(state.productionPlan).reduce((a,b)=>a+b,0);
        state.materialRequirements = {
          "电芯": totalProd * 2,
          "电解液": parseFloat((totalProd * 0.1).toFixed(1)),
          "壳体": totalProd
        };
        html = '<h2><i class="fas fa-cubes"></i> 步骤6：物料需求 BOM 展开</h2>' +
          '<p style="color:#6c7a89; margin-bottom:1rem;">基于生产计划 <strong style="color:#00d2ff;">'+totalProd.toLocaleString()+'</strong> 套，自动展开物料清单：</p>' +
          '<div class="bom-table">' +
            '<h4 style="margin-bottom:0.5rem; color:var(--theme);">BOM 物料清单（每套锂离子蓄电池PACK，车载/无人机通用）</h4>' +
            '<table><thead><tr><th>物料</th><th>单耗</th><th>单位</th><th>总需求量</th><th>说明</th></tr></thead><tbody>' +
            '<tr><td><img src="assets/li-cell.jpg" style="width:50px;height:40px;object-fit:cover;border-radius:4px;vertical-align:middle;margin-right:8px;"><i class="fas fa-bolt"></i> 电芯</td><td>2</td><td>组</td><td><strong style="color:var(--theme);">'+(totalProd*2).toLocaleString()+'</strong></td><td>方形铝壳/软包电芯（磷酸铁锂或三元）</td></tr>' +
            '<tr><td><img src="assets/li-electrolyte.jpg" style="width:50px;height:40px;object-fit:cover;border-radius:4px;vertical-align:middle;margin-right:8px;"><i class="fas fa-tint"></i> 电解液</td><td>0.1</td><td>桶</td><td><strong style="color:var(--theme);">'+(totalProd*0.1).toFixed(1)+'</strong></td><td>锂盐+有机溶剂（LiPF6/碳酸酯类）</td></tr>' +
            '<tr><td><img src="assets/li-shell.jpg" style="width:50px;height:40px;object-fit:cover;border-radius:4px;vertical-align:middle;margin-right:8px;"><i class="fas fa-box"></i> 壳体</td><td>1</td><td>个</td><td><strong style="color:var(--theme);">'+totalProd.toLocaleString()+'</strong></td><td>铝合金结构托盘（PACK外壳）</td></tr>' +
            '</tbody></table>' +
          '</div>' +
          '<div class="map3d-card" id="batteryExplode3d" style="height:340px;"><div class="scene-badge"><i class="fas fa-cubes"></i> 3D 蓄电池拆解视图</div><div class="scene-tip">拖拽旋转 · 点击部件</div></div>' +
          '<div class="slider-group" style="margin:.9rem 0;"><label>拆解程度：<output id="explodeVal" style="color:#00d2ff;font-weight:700;">40</output>%</label><input type="range" id="explodeSlider" min="0" max="100" value="40"></div>' +
          '<div class="card" id="partInfo"><h4><i class="fas fa-info-circle"></i> 部件说明</h4><p>点击 3D 视图中的部件查看详细信息；拖动滑块可调整拆解程度。</p></div>' +
          '<div class="card" style="margin-top:0.8rem;">' +
            '<h4><i class="fas fa-sliders-h"></i> 手动微调（考虑损耗率）</h4>' +
            '<div style="display:flex; gap:1.5rem; flex-wrap:wrap; margin-top:0.5rem;">' +
            Object.keys(state.materialRequirements).map(m =>
              '<label>'+m+'：<input type="number" id="mat_'+m+'" value="'+state.materialRequirements[m]+'" step="1"> '+(m==='电芯'?'组':m==='电解液'?'桶':'个')+'</label>'
            ).join('') +
            '</div></div>' +
          '<button class="primary" id="confirmBOM">确认物料需求 →</button>';
        break;
      }

      case 7: {
        let cards = MASTER_DATA.suppliers.map(s => {
          let sel = state.selectedSuppliers[s.id] ? 'selected' : '';
          return '<div class="supplier-card '+sel+'" data-id="'+s.id+'">' +
            '<span><strong>'+s.id+'</strong> <span class="tag">'+s.material+'</span></span>' +
            '<span style="font-size:0.85rem;">'+s.available+' | ¥'+s.price+'</span>' +
            '<i class="fas '+(sel?'fa-check-circle':'fa-circle')+'" style="color:'+(sel?'#00ff88':'#445')+';"></i></div>';
        }).join('');
        let selectedList = Object.keys(state.selectedSuppliers).length
          ? Object.keys(state.selectedSuppliers).map(id => '<span class="tag green">'+id+'</span>').join(' ')
          : '<p style="color:#667;">尚未选择</p>';
        html = '<h2><i class="fas fa-truck-loading"></i> 步骤7：供应商选择</h2>' +
          '<p style="color:#6c7a89;">点击卡片选择供应商（可多选），需覆盖三种物料需求。</p>' +
          '<div id="supplierList">'+cards+'</div>' +
          '<div class="card" style="margin-top:0.8rem;"><h4>已选供应商</h4><div id="selectedSuppliersDisplay">'+selectedList+'</div></div>' +
          '<button class="secondary" id="cheapestSuppliers" style="border-color:#9b59b6;color:#9b59b6;"><i class="fas fa-robot"></i> 自动选最低价</button>' +
          '<button class="primary" id="confirmSuppliers">确认供应商 →</button>';
        break;
      }

      case 8: {
        let today = new Date();
        let todayStr = today.getFullYear()+'年'+(today.getMonth()+1)+'月'+today.getDate()+'日';
        let routesHtml = MASTER_DATA.routes.map(r => {
          let qty = state.routeQuantities[r.id] || 0;
          let days = state.routeDays[r.id] || r.days;
          let sel = state.selectedRoutes[r.id] ? 'selected' : '';
          let icon = r.mode==='汽运'?'fa-truck':r.mode==='铁路'?'fa-train':'fa-ship';
          let arrive = new Date(today);
          arrive.setDate(arrive.getDate() + days);
          let arriveStr = (arrive.getMonth()+1)+'月'+arrive.getDate()+'日';
          let via = (r.legs && r.legs.length > 2) ? ' · 经 '+r.legs.slice(1,-1).join('→') : '';
          let kindTag = r.kind === 'product' ? '<span class="tag green">成品</span>' : '<span class="tag">原料</span>';
          let hazTag = r.hazard ? ' <span class="tag" style="background:#fdeaea;color:#c0392b;">危险品</span>' : '';
          let cost = hfRouteCost(r, qty);
          return '<div class="route-item '+sel+'" data-id="'+r.id+'" data-kind="'+r.kind+'">' +
            '<div><i class="fas '+icon+'" style="color:var(--theme);"></i> <strong>'+r.from+' → '+r.to+'</strong> ' + kindTag + hazTag + '<br>' +
            '<span style="font-size:0.8rem; color:#6c7a89;">'+r.dist+'km · '+r.mode+' · '+r.days+'天 · 出发：'+todayStr+' · 预计到达：<span class="arrive-date">'+arriveStr+'</span></span>' +
            '<div class="route-meta">起步价 ¥'+r.minFee+' · 运价 ¥'+r.rate+'/吨·km · 计费重 '+r.conv+'吨/'+r.unit+
            (via ? ' · '+via : '') + ' · 本线运费 <span class="route-cost" data-cost="'+r.id+'">¥'+Math.round(cost)+'</span></div></div>' +
            '<div style="display:flex; align-items:center; gap:0.8rem;">' +
            '<label style="font-size:0.8rem;">天数:<input type="number" class="route-days" data-route="'+r.id+'" value="'+days+'" min="1" max="60" style="width:60px;"></label>' +
            '<label style="font-size:0.8rem;">运输量:<input type="number" class="route-qty" data-route="'+r.id+'" value="'+qty+'" min="0" step="10" style="width:80px;"></label><span style="font-size:0.78rem;color:#6c7a89;">'+r.unit+'</span>' +
            '<i class="fas '+(sel?'fa-check-circle':'fa-circle')+'" style="color:'+(sel?'#27ae60':'#aab')+';"></i></div></div>';
        }).join('');
        html = '<h2><i class="fas fa-ship"></i> 步骤8：物流运输计划</h2>' +
          '<p style="color:#6c7a89;">今天：<strong>'+todayStr+'</strong> · 锂电供应链共 <strong>'+MASTER_DATA.routes.length+'</strong> 条路线（成品 '+MASTER_DATA.routes.filter(function(r){return r.kind==='product';}).length+' 条 / 原料 '+MASTER_DATA.routes.filter(function(r){return r.kind==='material';}).length+' 条），支持汽运 / 铁路 / 海运三种方式与港口、铁路枢纽中转。</p>' +
          '<p style="color:#6c7a89; font-size:0.82rem; margin-bottom:0.6rem;">运费 = MAX(起步价, 运输量 × 计费重 × 距离 × 运价)；<b>电芯组 0.05 吨/组、电解液桶 0.1 吨/桶、壳体个 0.2 吨/个、成品 PACK 0.9 吨/套</b>。电解液属危险化学品，运价已上浮；海运最便宜但最慢，铁路居中，汽运最快最贵。</p>' +

          '<div class="card" style="background:linear-gradient(135deg,#f0e6ff,#e8dfff); border:1px solid #9b59b6; margin-bottom:1rem;">' +
            '<h4 style="color:#7d3c98;"><i class="fas fa-robot"></i> AI物流优化建议</h4>' +
            '<ul style="font-size:0.85rem; color:#4a3a5e; line-height:1.9; margin-top:0.4rem; padding-left:1.2rem;">' +
              '<li><strong>成本优先：</strong>海运最便宜但最慢（9-15天），适合日本总代等远距离跨境订单；汽运最快（2-3天）但贵，适合国内紧急补货。</li>' +
              '<li><strong>多式联运：</strong>铁路+海运组合（如苏州→洋山港→横滨）比纯海运便宜30%，比纯汽运快5天，是跨境最优解。</li>' +
              '<li><strong>库存上限：</strong>每个网点有库存上限，超了要交超限费。建议分批运输，不要一次发太多。</li>' +
              '<li><strong>日本总代：</strong>涉及日元汇率，选盐田港出发比洋山港便宜，但多6天。时间充裕选盐田港。</li>' +
              '<li><strong>原料运输：</strong>供应商到工厂也需要运输距离，电芯重、体积大，优先选就近供应商（如宝鸡→广州）。</li>' +
            '</ul>' +
          '</div>' +

          '<div class="route-filter">' +
            '<button class="on" data-filter="all" onclick="hfFilterRoutes(this.dataset.filter, this)">全部 '+MASTER_DATA.routes.length+' 条</button>' +
            '<button data-filter="product" onclick="hfFilterRoutes(this.dataset.filter, this)">成品 '+MASTER_DATA.routes.filter(function(r){return r.kind==='product';}).length+' 条</button>' +
            '<button data-filter="material" onclick="hfFilterRoutes(this.dataset.filter, this)">原料 '+MASTER_DATA.routes.filter(function(r){return r.kind==='material';}).length+' 条</button>' +
          '</div>' +
          '<div id="routesList">'+routesHtml+'</div>' +
          '<div id="routeMap" style="height:300px; margin-top:1rem;"></div>' +
          '<div class="map3d-card" id="logiScene3d" style="height:330px;"><div class="scene-badge"><i class="fas fa-map-marker-alt"></i> 3D 多式联运网络地图</div><div class="scene-tip">拖拽旋转 · 点击节点 · 车辆沿选中路线行驶</div></div>' +
          '<div class="ops-panel"><h4><i class="fas fa-coins"></i> 运费汇总</h4><div class="freight-sum" id="freightGrid8"></div></div>' +
          '<button class="secondary" id="ecoRoutes" style="border-color:#e67e22;color:#e67e22;margin-right:0.5rem;"><i class="fas fa-leaf"></i> 经济路线推荐</button>' +
          '<button class="secondary" id="clearRoutes" style="border-color:#95a5a6;color:#7f8c8d;margin-right:0.5rem;"><i class="fas fa-undo"></i> 清空选择</button>' +
          '<button class="secondary" id="aiLogistics" style="border-color:#9b59b6;color:#9b59b6;margin-right:0.5rem;"><i class="fas fa-robot"></i> AI自动规划最优路线</button>' +
          '<button class="primary" id="confirmRoutes">确认物流计划 →</button>';
        break;
      }

      case 9: {
        let totalDemand = Object.values(state.demandForecast).reduce((a,b)=>a+b,0);
        let totalProd = Object.values(state.productionPlan).reduce((a,b)=>a+b,0);
        html = '<h2><i class="fas fa-vr-cardboard"></i> 步骤9：数字孪生模拟</h2>' +
          '<div class="twin-panel" style="display:flex; gap:1rem; flex-wrap:wrap;">' +
            '<div class="card" style="flex:1; min-width:250px;"><h4><i class="fas fa-sliders-h"></i> 外部环境参数调节</h4>' +
              '<div class="slider-group"><label>锂矿价格指数：<span id="lithiumVal" style="color:#00ff88;">100</span></label><input type="range" id="lithiumSlider" min="50" max="150" value="100"></div>' +
              '<div class="slider-group"><label>海运周期波动：<span id="shippingVal" style="color:#00ff88;">25</span> 天</label><input type="range" id="shippingSlider" min="15" max="45" value="25"></div>' +
              '<div class="slider-group"><label>生产良品率：<span id="yieldVal" style="color:#00ff88;">92</span>%</label><input type="range" id="yieldSlider" min="80" max="99" value="92"></div>' +
              '<div class="slider-group"><label>电池回收率：<span id="recycleVal" style="color:#00ff88;">35</span>%</label><input type="range" id="recycleSlider" min="0" max="70" value="35"></div>' +
            '</div>' +
            '<div class="card" style="flex:1; min-width:250px;"><h4><i class="fas fa-tachometer-alt"></i> 实时指标监控</h4>' +
              '<div class="gauge-grid">' +
                '<div class="gauge-item">单位电池成本<br><span class="value" id="twinCost">90.0</span><br><span style="font-size:0.7rem; color:#6c7a89;">$/kWh</span></div>' +
                '<div class="gauge-item">碳排放强度<br><span class="value" id="twinCarbon">85.0</span><br><span style="font-size:0.7rem; color:#6c7a89;">kgCO2</span></div>' +
                '<div class="gauge-item">供应链周期<br><span class="value" id="twinDays">45.0</span><br><span style="font-size:0.7rem; color:#6c7a89;">天</span></div>' +
              '</div></div>' +
          '</div>' +
          '<div class="map3d-card" id="supplierMap3d" style="height:330px;"><div class="scene-badge"><i class="fas fa-map-marker-alt"></i> 3D 供应链网络地图</div><div class="scene-tip">拖拽旋转 · 点击节点 · 车辆沿选中路线行驶</div></div>' +
          '<div class="ops-panel"><h4><i class="fas fa-calculator"></i> 运营汇总（运费与回收）</h4><div class="freight-sum" id="freightGrid"></div><div id="recycleSumRow"></div></div>' +
          '<div id="twinChart" style="height:240px; margin-top:0.5rem;"></div>' +
          '<div class="card" style="margin-top:0.5rem;"><h4>配置摘要</h4>' +
            '<p style="font-size:0.9rem;">总需求：<strong style="color:#00d2ff;">'+totalDemand.toLocaleString()+'</strong>套 | ' +
            '总生产：<strong style="color:#00d2ff;">'+totalProd.toLocaleString()+'</strong>套 | ' +
            '供应商：<strong style="color:#00ff88;">'+Object.keys(state.selectedSuppliers).length+'</strong>家 | ' +
            '路线：<strong style="color:#00ff88;">'+Object.keys(state.selectedRoutes).length+'</strong>条</p></div>' +
          '<button class="primary" id="runFullSim" style="font-size:1.1rem; padding:0.8rem 2.5rem;"><i class="fas fa-rocket"></i> 运行60天动态模拟</button>' +
          '<div id="simResultText" class="hidden" style="margin-top:1rem;"></div>' +
          '<button class="secondary hidden" id="viewResults">查看实验成绩 →</button>';
        break;
      }

      case 10: {
        if (!state.simulationResult) {
          html = '<h2><i class="fas fa-trophy"></i> 实验成绩</h2><p style="color:#6c7a89;">尚未运行模拟，请先完成步骤9。</p><button class="primary" onclick="window._nav(9)">返回数字孪生</button>';
        } else {
          const r = state.simulationResult;
          html = '<h2><i class="fas fa-trophy"></i> 步骤10：实验成绩评定</h2>' +
            '<div class="gauge-grid">' +
              '<div class="gauge-item"><h4>采购成本</h4><span class="value">'+r.unitProcCost+'</span><p style="font-size:0.8rem; color:#6c7a89;">得分：'+r.procScore+'/25</p></div>' +
              '<div class="gauge-item"><h4>物流成本</h4><span class="value">'+r.unitLogCost+'</span><p style="font-size:0.8rem; color:#6c7a89;">得分：'+r.logScore+'/25</p></div>' +
              '<div class="gauge-item"><h4>市场满足率</h4><span class="value">'+r.fillRate+'%</span><p style="font-size:0.8rem; color:#6c7a89;">得分：'+r.fillScore+'/20</p></div>' +
              '<div class="gauge-item"><h4>生产满足率</h4><span class="value">'+r.prodRate+'%</span><p style="font-size:0.8rem; color:#6c7a89;">得分：'+r.prodScore+'/15</p></div>' +
              '<div class="gauge-item"><h4>预测偏差</h4><span class="value">'+r.deviation+'%</span><p style="font-size:0.8rem; color:#6c7a89;">得分：'+r.devScore+'/15</p></div>' +
            '</div>' +
            '<div class="card" style="margin-top:1rem; border-left:4px solid #27ae60;">' +
              '<h4><i class="fas fa-balance-scale" style="color:#27ae60;"></i> 五维运营考核指标</h4>' +
              '<div style="display:grid; grid-template-columns:repeat(5,1fr); gap:0.6rem; margin-top:0.6rem; text-align:center;">' +
                '<div style="background:#eafaf1; padding:0.6rem; border-radius:0.5rem;"><div style="font-weight:700; color:#1e8449;">净资产</div><div style="font-size:0.8rem; color:#145a32;">'+(2000 - 800*state.factoryUpgrade - (state.loanChoice?state.loanChoice*0.05:0)).toFixed(0)+'万</div></div>' +
                '<div style="background:#eaf2f8; padding:0.6rem; border-radius:0.5rem;"><div style="font-weight:700; color:#21618c;">市场占有率</div><div style="font-size:0.8rem; color:#1a5276;">'+r.fillRate+'%</div></div>' +
                '<div style="background:#fef9e7; padding:0.6rem; border-radius:0.5rem;"><div style="font-weight:700; color:#9a7d0a;">库存周转率</div><div style="font-size:0.8rem; color:#7d6608;">'+(r.fillRate/100*8.2).toFixed(1)+'次/季</div></div>' +
                '<div style="background:#f4ecf7; padding:0.6rem; border-radius:0.5rem;"><div style="font-weight:700; color:#6c3483;">准时交货率</div><div style="font-size:0.8rem; color:#512e5f;">'+(r.fillRate-2)+'%</div></div>' +
                '<div style="background:#fdedec; padding:0.6rem; border-radius:0.5rem;"><div style="font-weight:700; color:#c0392b;">现金流管理</div><div style="font-size:0.8rem; color:#7b241c;">'+(state.loanChoice?'有贷款':'现金流充足')+'</div></div>' +
              '</div>' +
            '</div>' +
            '<div class="card" style="text-align:center; margin-top:1rem;">' +
              '<h3>本次实验总分</h3>' +
              '<span style="font-size:3rem; font-weight:700; color:var(--theme);">'+r.totalScore+'</span> <span style="color:#6c7a89;">/ 100</span>' +
            '</div>' +
            '<div style="margin-top:1rem;"><h4><i class="fas fa-list"></i> 实验成绩记录（最新 ' + LEDGER_ROWS + ' 条，与末步台账一致）</h4>' +
            '<div class="score-roll" id="scoreRollContainer"></div></div>' +
            '<div style="margin-top:0.8rem; display:flex; gap:0.8rem; flex-wrap:wrap;">' +
              '<button class="btn-download" id="downloadExcelBtn"><i class="fas fa-file-excel"></i> 导出成绩Excel</button>' +
              '<button class="secondary" id="goToReview">进入复盘分析 →</button></div>' +
            '<div style="margin-top:0.8rem;"><h4><i class="fas fa-search"></i> 历史成绩查询</h4>' +
            '<input type="text" id="historySearchInput" placeholder="输入用户名搜索" style="background:#fff;border:1px solid #d0d8e0;color:#2c3e50;padding:0.4rem 1rem;border-radius:1rem;width:200px;">' +
            '<button class="primary" id="historySearchBtn" style="padding:0.4rem 1rem; margin-left:0.4rem;">查询</button>' +
            '<div id="historyResult" style="margin-top:0.4rem;"></div></div>';
          setTimeout(() => { renderScoreRoll(); }, 100);
        }
        break;
      }

      case 11: {
        let totalDemand = Object.values(state.demandForecast).reduce((a,b)=>a+b,0);
        let totalProd = Object.values(state.productionPlan).reduce((a,b)=>a+b,0);
        let supCnt = Object.keys(state.selectedSuppliers).length;
        let routeCnt = Object.keys(state.selectedRoutes).length;
        let transQty = Object.values(state.routeQuantities).reduce((a,b)=>a+(parseInt(b)||0),0);
        html = '<h2><i class="fas fa-redo"></i> 步骤11：复盘分析</h2>' +
          '<div id="reviewFlowChart" style="height:350px; margin:0.8rem 0;"></div>' +
          '<div class="flex-row">' +
            '<div class="card"><h4><i class="fas fa-calculator"></i> 关键决策数据</h4>' +
              '<table>' +
              '<tr><td>总需求预测</td><td><strong>'+totalDemand.toLocaleString()+'</strong> 套</td></tr>' +
              '<tr><td>总生产计划</td><td><strong>'+totalProd.toLocaleString()+'</strong> 套</td></tr>' +
              '<tr><td>选定供应商</td><td><strong>'+supCnt+'</strong> 家</td></tr>' +
              '<tr><td>运输路线</td><td><strong>'+routeCnt+'</strong> 条</td></tr>' +
              '<tr><td>总运输量</td><td><strong>'+transQty.toLocaleString()+'</strong> 套</td></tr>' +
              '<tr><td>知识小测得分</td><td><strong style="color:#00ff88;">'+state.quizScore+'</strong>/3</td></tr>' +
              '</table></div>' +
            '<div class="card"><h4><i class="fas fa-lightbulb"></i> 智能优化建议</h4><div id="suggestionList"></div></div>' +
          '</div>' +
          '<div class="card" style="margin-top:0.8rem;"><h4><i class="fas fa-sticky-note"></i> 实验复盘笔记</h4>' +
            '<textarea id="reviewNotes" style="width:100%; height:70px; background:#fff; color:#2c3e50; border:1px solid #d0d8e0; border-radius:0.6rem; padding:0.6rem; margin-top:0.4rem;" placeholder="记录本次实验的收获与改进方向..."></textarea></div>' +
          '<div class="card" style="margin-top:0.8rem;">' +
            '<h4><i class="fas fa-table"></i> 实验成绩台账（最新 ' + LEDGER_ROWS + ' 条 · Excel 表格视图 · 实时更新）</h4>' +
            '<div class="ledger-wrap"><table class="ledger-table" id="ledgerTable"></table></div>' +
            '<div style="margin-top:0.8rem; display:flex; gap:0.8rem; flex-wrap:wrap; align-items:center;">' +
              '<button class="btn-download" id="downloadLedgerBtn"><i class="fas fa-file-excel"></i> 导出台账Excel</button>' +
              '<button class="secondary" id="refreshLedgerBtn"><i class="fas fa-sync-alt"></i> 刷新台账</button>' +
              '<span style="font-size:0.8rem; color:#6c7a89;">累计参与实验：<strong style="color:var(--theme);" id="participantTotalBadge">' + participantTotal() + '</strong> 人次（基线 ' + PARTICIPANT_BASE + ' 人次，后期每次登录按 ' + LOGIN_INCREMENT + ' 人次登记）</span>' +
            '</div></div>' +
          '<button class="primary" id="saveReview"><i class="fas fa-save"></i> 保存复盘笔记</button>' +
          '<button class="secondary" id="resetExperiment"><i class="fas fa-redo"></i> 重新开始实验</button>';
        setTimeout(() => { renderLedger(); }, 100);
        break;
      }

      default: html = '<p>未知步骤</p>';
    }
    stepContent.innerHTML = html;
    bindEvents(step);
    if (step === 3) initQuiz();
    if (step === 4) initDemandChart();
    if (step === 8) { initRouteMap(); mountLogiScene3D(document.getElementById('logiScene3d')); updateFreightSummary(); }
    if (step === 2) initFlipCards();
    if (step === 5) mountFactoryScene(document.getElementById('factoryScene3d'));
    if (step === 6) mountBatteryScene(document.getElementById('batteryExplode3d'), document.getElementById('explodeSlider'), document.getElementById('partInfo'));
    if (step === 9) { initTwinDashboard(); updateTwinMetrics(); initSupplierMap3D(); updateFreightSummary(); }
    if (step === 11) initReviewFlowChart();
  }

  // ========== 知识小测 ==========
  const quizData = [
    {
      q: "1. 锂离子蓄电池（车载/无人机通用）电芯内部五大件不包括以下哪项？",
      options: ["正极", "隔膜", "传动齿轮", "壳体"],
      answer: 2,
      explain: "电芯内部五大件为正极、负极、隔膜、电解液、壳体，传动齿轮与电池无关。"
    },
    {
      q: "2. 电芯直接排列在电池包内部、取消模组这一层的技术是？",
      options: ["CTP（Cell To Pack）", "传统模组方案", "铅酸电池", "超级电容"],
      answer: 0,
      explain: "CTP（Cell To Pack）技术取消模组层，电芯直接排布在电池包内；刀片、麒麟电池都属于CTP方案。"
    },
    {
      q: "3. 工厂或仓库库存超过上限时会产生什么费用？",
      options: ["运输费", "超限费", "采购费", "保险费"],
      answer: 1,
      explain: "库存超过上限会产生超限费，需合理安排分批次送货控制库存。"
    }
  ];
  let quizAnswers = [];

  function initQuiz() {
    quizAnswers = [];
    const container = document.getElementById('quizContainer');
    if (!container) return;
    container.innerHTML = quizData.map((item, qi) =>
      '<div class="card" style="margin-bottom:0.8rem;">' +
      '<p style="font-weight:600; margin-bottom:0.5rem;">'+item.q+'</p>' +
      item.options.map((opt, oi) =>
        '<div class="quiz-option" data-q="'+qi+'" data-o="'+oi+'"><span class="opt-label">'+String.fromCharCode(65+oi)+'</span><span>'+opt+'</span></div>'
      ).join('') +
      '</div>'
    ).join('');
    document.querySelectorAll('.quiz-option').forEach(opt => {
      opt.addEventListener('click', function() {
        const q = parseInt(this.dataset.q);
        const o = parseInt(this.dataset.o);
        // 清除该题之前的选择
        document.querySelectorAll('.quiz-option[data-q="'+q+'"]').forEach(e => e.classList.remove('selected'));
        this.classList.add('selected');
        quizAnswers[q] = o;
        document.getElementById('submitQuizBtn').classList.remove('hidden');
      });
    });
    document.getElementById('submitQuizBtn')?.addEventListener('click', submitQuiz);
  }

  function submitQuiz() {
    const unanswered = quizData.filter((_, i) => quizAnswers[i] === undefined);
    if (unanswered.length > 0) {
      alert('还有 ' + unanswered.length + ' 道题未作答，请完成所有题目再提交');
      return;
    }
    let score = 0;
    quizData.forEach((item, i) => {
      const opts = document.querySelectorAll('.quiz-option[data-q="'+i+'"]');
      if (quizAnswers[i] === item.answer) {
        score++;
        opts[quizAnswers[i]].classList.add('correct');
      } else {
        opts[quizAnswers[i]]?.classList.add('wrong');
        opts[item.answer].classList.add('correct');
      }
    });
    state.quizScore = score;
    const resultEl = document.getElementById('quizResult');
    resultEl.classList.remove('hidden');
    resultEl.innerHTML = '<div class="card" style="text-align:center;">' +
      '<h4>小测结果</h4>' +
      '<span class="value">'+score+'</span> / '+quizData.length+' 题正确' +
      '<p style="margin-top:0.5rem; color:#6c7a89; font-size:0.85rem;">'+(score===3?'优秀！供应链基础扎实。':score===2?'良好，继续加油。':'建议复习供应链基础知识。')+'</p></div>';
    document.getElementById('submitQuizBtn').classList.add('hidden');
    document.getElementById('nextAfterQuizBtn').classList.remove('hidden');
    document.getElementById('nextAfterQuizBtn').addEventListener('click', () => {
      completeStep(3); navigateToStep(4);
    }, { once: true });
  }

  // ========== 事件绑定 ==========
  function bindEvents(step) {
    if (step === 2) {
      document.getElementById('confirmStep2')?.addEventListener('click', () => {
        completeStep(2); navigateToStep(3);
      });
    }
    if (step === 4) {
      document.querySelectorAll('[id$="_slider"]').forEach(sl => {
        sl.addEventListener('input', function() {
          const id = this.id.replace('_slider','');
          const valEl = document.getElementById(id+'_val');
          if (valEl) valEl.textContent = this.value;
          state.demandForecast[id] = parseInt(this.value);
          // 更新进度条
          this.parentElement.querySelector('.progress-fill').style.width = (this.value/40000*100)+'%';
          updateDemandChart();
        });
      });
      document.getElementById('saveForecast')?.addEventListener('click', () => {
        completeStep(4); notify('需求预测已保存');
      });
      document.getElementById('resetForecast')?.addEventListener('click', () => {
        MASTER_DATA.salesPoints.forEach(p => {
          state.demandForecast[p.id] = p.forecast;
          const sl = document.getElementById(p.id+'_slider'); if(sl) sl.value = p.forecast;
          const v = document.getElementById(p.id+'_val'); if(v) v.textContent = p.forecast;
          sl.dispatchEvent(new Event('input'));
        });
        toast('已恢复默认预测值');
      });
      document.getElementById('aiForecast')?.addEventListener('click', () => {
        MASTER_DATA.salesPoints.forEach(p => {
          const avg = Math.round(p.history.reduce((a,b)=>a+b,0)/p.history.length);
          state.demandForecast[p.id] = avg;
          const sl = document.getElementById(p.id+'_slider'); if(sl) sl.value = avg;
          const v = document.getElementById(p.id+'_val'); if(v) v.textContent = avg;
          sl.dispatchEvent(new Event('input'));
        });
        toast('AI已按历史月均自动填充预测');
      });
    }
    if (step === 5) {
      document.querySelectorAll('[id$="_prod"]').forEach(inp => {
        inp.addEventListener('input', function() {
          const factory = this.id.replace('_prod','');
          state.productionPlan[factory] = parseInt(this.value) || 0;
          updateReplenishmentDisplay();
        });
      });
      document.getElementById('autoProd')?.addEventListener('click', () => {
        let totalDemand = Object.values(state.demandForecast).reduce((a,b)=>a+b,0);
        let gzMax = 86520, szMax = 105060;
        let totalCap = gzMax + szMax;
        let gzShare = Math.min(gzMax, Math.round(totalDemand * gzMax / totalCap));
        let szShare = Math.min(szMax, totalDemand - gzShare);
        state.productionPlan['广州PACK厂'] = gzShare;
        state.productionPlan['苏州PACK厂'] = szShare;
        const gz = document.getElementById('广州PACK厂_prod'); if(gz) gz.value = gzShare;
        const sz = document.getElementById('苏州PACK厂_prod'); if(sz) sz.value = szShare;
        updateReplenishmentDisplay();
        toast('已按产能比例自动分配生产计划');
      });
      document.getElementById('confirmProduction')?.addEventListener('click', () => {
        completeStep(5); navigateToStep(6);
      });
      updateReplenishmentDisplay();
    }
    if (step === 6) {
      document.querySelectorAll('[id^="mat_"]').forEach(inp => {
        inp.addEventListener('input', function() {
          const mat = this.id.replace('mat_','');
          state.materialRequirements[mat] = parseFloat(this.value) || 0;
        });
      });
      document.getElementById('confirmBOM')?.addEventListener('click', () => {
        completeStep(6); navigateToStep(7);
      });
    }
    if (step === 7) {
      document.querySelectorAll('.supplier-card').forEach(card => {
        card.addEventListener('click', function() {
          const id = this.dataset.id;
          if (state.selectedSuppliers[id]) {
            delete state.selectedSuppliers[id]; this.classList.remove('selected');
          } else {
            state.selectedSuppliers[id] = true; this.classList.add('selected');
          }
          updateSelectedSuppliersDisplay();
        });
      });
      document.getElementById('cheapestSuppliers')?.addEventListener('click', () => {
        const byMaterial = {};
        MASTER_DATA.suppliers.forEach(s => {
          if (!byMaterial[s.material] || s.price < byMaterial[s.material].price) byMaterial[s.material] = s;
        });
        state.selectedSuppliers = {};
        document.querySelectorAll('.supplier-card').forEach(c => c.classList.remove('selected'));
        Object.values(byMaterial).forEach(s => {
          state.selectedSuppliers[s.id] = true;
          const card = document.querySelector('.supplier-card[data-id="'+s.id+'"]');
          if (card) card.classList.add('selected');
        });
        updateSelectedSuppliersDisplay();
        toast('已自动选中每种物料最低价供应商');
      });
      document.getElementById('confirmSuppliers')?.addEventListener('click', () => {
        if (Object.keys(state.selectedSuppliers).length === 0) { alert('至少选择一家供应商'); return; }
        completeStep(7); navigateToStep(8);
      });
    }
    if (step === 8) {
      document.querySelectorAll('.route-item').forEach(item => {
        item.addEventListener('click', function(e) {
          if (e.target.tagName === 'INPUT') return;
          const id = this.dataset.id;
          if (state.selectedRoutes[id]) {
            delete state.selectedRoutes[id]; this.classList.remove('selected');
          } else {
            state.selectedRoutes[id] = true; this.classList.add('selected');
          }
          initRouteMap();
          updateFreightSummary();
          hfRefreshLogiScene();
        });
      });
      document.querySelectorAll('.route-qty').forEach(inp => {
        inp.addEventListener('input', function() {
          state.routeQuantities[this.dataset.route] = parseInt(this.value) || 0;
          hfRefreshRouteCost(this.dataset.route);
          updateFreightSummary();
        });
        inp.addEventListener('click', e => e.stopPropagation());
      });
      document.querySelectorAll('.route-days').forEach(inp => {
        inp.addEventListener('input', function() {
          state.routeDays[this.dataset.route] = parseInt(this.value) || 1;
          // 更新到达日期
          let today = new Date();
          let arrive = new Date(today);
          arrive.setDate(arrive.getDate() + (parseInt(this.value) || 1));
          let arriveStr = (arrive.getMonth()+1)+'月'+arrive.getDate()+'日';
          let item = this.closest('.route-item');
          if (item) {
            let el = item.querySelector('.arrive-date');
            if (el) el.textContent = arriveStr;
          }
        });
        inp.addEventListener('click', e => e.stopPropagation());
      });
      document.getElementById('aiLogistics')?.addEventListener('click', () => {
        hfAiPlanMultimodal();
      });
      document.getElementById('ecoRoutes')?.addEventListener('click', () => {
        hfEcoRoutePlan();
      });
      document.getElementById('clearRoutes')?.addEventListener('click', () => {
        state.selectedRoutes = {}; state.routeQuantities = {}; state.routeDays = {};
        document.querySelectorAll('.route-item').forEach(c => { c.classList.remove('selected');
          const q = c.querySelector('.route-qty'); if (q) q.value = 0;
          const d = c.querySelector('.route-days'); if (d) d.value = MASTER_DATA.routes.find(x=>x.id===c.dataset.id).days; });
        initRouteMap(); updateFreightSummary(); hfRefreshLogiScene();
        toast('已清空物流选择');
      });
      document.getElementById('confirmRoutes')?.addEventListener('click', () => {
        if (Object.keys(state.selectedRoutes).length === 0) { alert('至少选择一条路线'); return; }
        completeStep(8); navigateToStep(9);
      });
    }
    if (step === 9) {
      ['lithium','shipping','yield','recycle'].forEach(id => {
        document.getElementById(id+'Slider')?.addEventListener('input', () => { updateTwinMetrics(); updateFreightSummary(); });
      });
      document.getElementById('runFullSim')?.addEventListener('click', runSimulation);
      document.getElementById('viewResults')?.addEventListener('click', () => navigateToStep(10));
    }
    if (step === 10) {
      document.getElementById('goToReview')?.addEventListener('click', () => {
        completeStep(10); navigateToStep(11);
      });
      document.getElementById('downloadExcelBtn')?.addEventListener('click', downloadExcel);
      const searchBtn = document.getElementById('historySearchBtn');
      if (searchBtn) searchBtn.addEventListener('click', renderHistorySearch);
    }
    if (step === 11) {
      document.getElementById('saveReview')?.addEventListener('click', () => {
        completeStep(11); notify('复盘笔记已保存！实验完成。');
      });
      document.getElementById('resetExperiment')?.addEventListener('click', resetExperiment);
      document.getElementById('downloadLedgerBtn')?.addEventListener('click', downloadExcel);
      document.getElementById('refreshLedgerBtn')?.addEventListener('click', async () => {
        await pullStats();
        renderLedger();
        notify('台账已刷新');
      });
      // 渲染优化建议
      renderSuggestions();
    }
  }

  // ========== 辅助函数 ==========
  function updateReplenishmentDisplay() {
    const display = document.getElementById('replenishmentDisplay');
    if (!display) return;
    const totalProd = Object.values(state.productionPlan).reduce((a,b)=>a+b,0);
    const totalDemand = Object.values(state.demandForecast).reduce((a,b)=>a+b,0);
    let html = '<table><tr><th>销售网点</th><th>预测需求</th><th>建议补货量</th></tr>';
    MASTER_DATA.salesPoints.forEach(p => {
      const ratio = totalDemand > 0 ? state.demandForecast[p.id]/totalDemand : 0;
      html += '<tr><td>'+p.id+'</td><td>'+state.demandForecast[p.id]+'套</td><td><strong style="color:#00ff88;">'+Math.round(totalProd*ratio)+'套</strong></td></tr>';
    });
    html += '</table>';
    display.innerHTML = html;
  }

  function updateSelectedSuppliersDisplay() {
    const display = document.getElementById('selectedSuppliersDisplay');
    if (!display) return;
    const sel = Object.keys(state.selectedSuppliers);
    if (!sel.length) { display.innerHTML = '<p style="color:#667;">尚未选择</p>'; return; }
    display.innerHTML = sel.map(id => {
      const s = MASTER_DATA.suppliers.find(sp => sp.id === id);
      return '<span class="tag green">'+s.id+'</span>';
    }).join(' ');
  }

  function renderSuggestions() {
    const el = document.getElementById('suggestionList');
    if (!el) return;
    let s = [];
    if (state.simulationResult) {
      if (parseFloat(state.simulationResult.fillRate) < 95) s.push('市场满足率偏低，建议增加产量或优化物流路线。');
      if (parseFloat(state.simulationResult.deviation) > 10) s.push('预测偏差较大，建议参考历史月均数据调整预测。');
      if (parseFloat(state.simulationResult.unitProcCost) > 4) s.push('采购成本偏高，考虑选择单价更低的供应商。');
    }
    if (state.quizScore < 3) s.push('知识小测有错题，建议复习BOM结构和运输方式特点。');
    if (Object.keys(state.selectedSuppliers).length < 4) s.push('供应商选择较少，分散供应商可降低断供风险。');
    if (s.length === 0) s.push('各项指标表现良好，可尝试微调参数挑战更高分。');
    el.innerHTML = s.map(t => '<li style="margin:0.3rem 0; color:#5a6c7d;">'+t+'</li>').join('');
  }

  // ========== 图表函数 ==========
  // echarts CDN 不可达时的降级提示（离线/内网/cdn被墙场景）
  function chartGuard(dom, label) {
    if (typeof echarts === 'undefined' || !echarts || !echarts.init) {
      if (dom) {
        dom.innerHTML = '<div style="height:100%; display:flex; align-items:center; justify-content:center; ' +
          'color:#8a97a6; font-size:0.85rem; text-align:center; padding:1rem; line-height:1.8;">' +
          '[' + label + '] 图表组件未加载（echarts CDN 不可达）<br>' +
          '<span style="font-size:0.75rem;">平台其余功能与数据不受影响，可继续完成实验</span></div>';
      }
      return null;
    }
    return true;
  }

  function updateDemandChart() {
    const dom = document.getElementById('demandChart');
    if (!dom) return;
    if (!chartGuard(dom, '需求预测对比图')) return;
    const chart = echarts.getInstanceByDom(dom) || echarts.init(dom);
    chart.setOption({
      backgroundColor: 'transparent',
      title: { text: '需求预测 vs 历史月均', left: 'center', textStyle: { color: '#5a6c7d', fontSize: 13 } },
      legend: { data: ['历史月均', '本次预测'], bottom: 0, textStyle: { color: '#6c7a89' } },
      xAxis: { data: MASTER_DATA.salesPoints.map(p => p.id), axisLabel: { color: '#ccc' } },
      yAxis: { axisLabel: { color: '#ccc' } },
      series: [
        { name: '历史月均', data: MASTER_DATA.salesPoints.map(p => Math.round(p.history.reduce((a,b)=>a+b,0)/6)), type: 'bar', color: '#446688', itemStyle: { borderRadius: [4,4,0,0] } },
        { name: '本次预测', data: MASTER_DATA.salesPoints.map(p => state.demandForecast[p.id]), type: 'bar', color: '#00d2ff', itemStyle: { borderRadius: [4,4,0,0] } }
      ]
    });
  }
  function initDemandChart() { updateDemandChart(); }

  function initRouteMap() {
    const dom = document.getElementById('routeMap');
    if (!dom) return;
    if (!chartGuard(dom, '物流路线网络图')) return;
    const chart = echarts.init(dom);
    const reg = hfLogiRegistry();
    const nodes = [], links = [], nodeMap = {};
    function push(nm, type) {
      if (nodeMap[nm]) return;
      nodeMap[nm] = true;
      const nd = reg[nm] || { x: 0, z: 0, type: 'other' };
      nodes.push({ name: nm, x: (nd.x + 5) * 62, y: (nd.z + 4) * 32,
        symbolSize: nd.type === 'fac' ? 22 : nd.type === 'hub' ? 16 : 14,
        itemStyle: { color: hfNodeColor(nd.type) } });
    }
    MASTER_DATA.routes.forEach(r => { (r.legs || [r.from, r.to]).forEach(push); });
    MASTER_DATA.routes.forEach(r => {
      const legs = r.legs || [r.from, r.to];
      for (let i = 0; i < legs.length - 1; i++) {
        const a = nodes.findIndex(n => n.name === legs[i]);
        const b = nodes.findIndex(n => n.name === legs[i+1]);
        if (a < 0 || b < 0) continue;
        const sel = !!state.selectedRoutes[r.id];
        const last = i === legs.length - 2;
        links.push({
          source: a, target: b,
          label: { show: last, formatter: r.dist+'km · '+r.mode, color: '#7b8b9c', fontSize: 9 },
          lineStyle: { color: sel ? '#00ff88' : '#9fc4d8', width: sel ? 3 : 1.2, curveness: 0.18,
            type: r.mode === '铁路' ? 'dashed' : (r.mode === '海运' ? 'solid' : 'solid') }
        });
      }
    });
    chart.setOption({
      backgroundColor: 'transparent',
      title: { text: '锂电多式联运网络图（虚线＝铁路，跨枢纽＝海运/铁路中转）', left: 'center',
        textStyle: { color: '#2c3e50', fontSize: 13, fontWeight: 'bold' } },
      series: [{
        type: 'graph', layout: 'force', roam: true, data: nodes, links,
        force: { repulsion: 600, edgeLength: [130, 280] },
        label: { show: true, color: '#3d4d5c', fontSize: 10 },
        emphasis: { focus: 'adjacency' }
      }]
    });
  }

  function updateTwinMetrics() {
    const li = parseInt(document.getElementById('lithiumSlider')?.value) || 100;
    const sh = parseInt(document.getElementById('shippingSlider')?.value) || 25;
    const yi = parseInt(document.getElementById('yieldSlider')?.value) || 92;
    const re = parseInt(document.getElementById('recycleSlider')?.value) || 35;
    document.getElementById('lithiumVal').textContent = li;
    document.getElementById('shippingVal').textContent = sh;
    document.getElementById('yieldVal').textContent = yi;
    document.getElementById('recycleVal').textContent = re;
    const cost = (90*(li/100)*(1+(sh-15)/100) - 5*((yi-80)/19) - 8*(re/70)).toFixed(1);
    const carbon = (80 + (sh-15)*0.5 - re*0.4).toFixed(1);
    const days = (45 + (sh-15) - (yi-80)*0.3).toFixed(1);
    document.getElementById('twinCost').textContent = cost;
    document.getElementById('twinCarbon').textContent = carbon;
    document.getElementById('twinDays').textContent = days;
  }

  function initTwinDashboard() {
    const dom = document.getElementById('twinChart');
    if (!dom) return;
    if (!chartGuard(dom, '供应链绩效雷达图')) return;
    const chart = echarts.init(dom);
    chart.setOption({
      backgroundColor: 'transparent',
      title: { text: '供应链绩效雷达', left: 'center', textStyle: { color: '#ccc', fontSize: 13 } },
      radar: {
        indicator: [
          { name: '采购效率', max: 100 }, { name: '生产效率', max: 100 },
          { name: '物流效率', max: 100 }, { name: '销售达成', max: 100 },
          { name: '回收利用', max: 100 }
        ],
        axisName: { color: '#ccc' }
      },
      series: [{
        type: 'radar',
        data: [{
          value: [85, 92, 78, 88, 65], name: '当前方案',
          areaStyle: { color: 'rgba(0,255,136,0.2)' },
          lineStyle: { color: '#00ff88' }
        }]
      }]
    });
  }

  function initReviewFlowChart() {
    const dom = document.getElementById('reviewFlowChart');
    if (!dom) return;
    if (!chartGuard(dom, '供应链端到端流动图')) return;
    const totalDemand = Object.values(state.demandForecast).reduce((a,b)=>a+b,0);
    const totalProd = Object.values(state.productionPlan).reduce((a,b)=>a+b,0);
    const supCnt = Object.keys(state.selectedSuppliers).length;
    const routeCnt = Object.keys(state.selectedRoutes).length;
    const transQty = Object.values(state.routeQuantities).reduce((a,b)=>a+(parseInt(b)||0),0);
    const chart = echarts.init(dom);
    const data = [
      { name: '供应商('+supCnt+'家)' },
      { name: '原料入库' },
      { name: '工厂生产('+totalProd.toLocaleString()+')' },
      { name: '物流运输('+routeCnt+'条)' },
      { name: '销售网点' }
    ];
    const links = [
      { source: data[0].name, target: data[1].name, value: 100 },
      { source: data[1].name, target: data[2].name, value: totalProd || 1 },
      { source: data[2].name, target: data[3].name, value: transQty || totalProd || 1 },
      { source: data[3].name, target: data[4].name, value: transQty || totalProd || 1 }
    ];
    chart.setOption({
      backgroundColor: 'transparent',
      title: { text: '供应链端到端流动图', left: 'center', textStyle: { color: '#2c3e50', fontSize: 14, fontWeight: 'bold' } },
      tooltip: { trigger: 'item' },
      series: [{
        type: 'sankey', layout: 'none', emphasis: { focus: 'adjacency' },
        nodeAlign: 'left', data: data, links: links,
        label: { color: '#2c3e50', fontSize: 12, fontWeight: 600 },
        lineStyle: { color: 'gradient', curveness: 0.5, opacity: 0.65, width: 3 },
        levels: [
          { depth: 0, itemStyle: { color: '#ffaa44' } },
          { depth: 1, itemStyle: { color: '#0099cc' } },
          { depth: 2, itemStyle: { color: '#00ff88' } },
          { depth: 3, itemStyle: { color: '#ff6688' } },
          { depth: 4, itemStyle: { color: '#aa88ff' } }
        ]
      }]
    });
  }

  // ========== 3D供应链节点地图（增强版，可点击） ==========
  function initSupplierMap3D() {
    const container = document.getElementById('supplierMap3d');
    if (!container) return;
    if (window.__supplierRaf) { try { cancelAnimationFrame(window.__supplierRaf); } catch(e){} }
    while (container.firstChild) container.removeChild(container.firstChild);
    if (typeof THREE === 'undefined' || !THREE) {
      container.innerHTML = '<div style="height:100%; display:flex; align-items:center; justify-content:center; ' +
        'color:#8a97a6; font-size:0.85rem; text-align:center; padding:1rem; line-height:1.8;">' +
        '[3D供应链节点地图] 3D组件未加载（three.js CDN 不可达）<br>' +
        '<span style="font-size:0.75rem;">孪生参数调节、60天模拟与成绩评定功能不受影响</span></div>';
      return;
    }
    const label = document.createElement('div');
    label.className = 'map-label';
    label.innerHTML = '<i class="fas fa-map-marker-alt"></i> 3D供应链节点地图（拖拽旋转 · 点击节点查看详情）';
    container.appendChild(label);

    const width = container.clientWidth || 600;
    const height = container.clientHeight || 300;
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x060f22);
    const camera = new THREE.PerspectiveCamera(50, width/height, 0.1, 100);
    camera.position.set(6, 5, 10);
    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(width, height);
    renderer.shadowMap.enabled = true;
    container.appendChild(renderer.domElement);

    scene.add(new THREE.AmbientLight(0x404060, 0.8));
    const dirLight = new THREE.DirectionalLight(0xffffff, 1.2);
    dirLight.position.set(5, 10, 7);
    dirLight.castShadow = true;
    scene.add(dirLight);
    const blueLight = new THREE.PointLight(0x00d2ff, 0.6, 20);
    blueLight.position.set(-5, 3, -5);
    scene.add(blueLight);

    const grid = new THREE.GridHelper(12, 16, 0x00d2ff, 0x1a3a5a);
    grid.position.y = -1.5;
    scene.add(grid);

    const nodes = [
      { name: '石家庄电芯厂', type: 'supplier', pos: [-3, 0.5, 2], desc: '电芯供应商，日产能2828组，单价96元' },
      { name: '宝鸡电芯厂', type: 'supplier', pos: [-3.5, -0.3, -1], desc: '电芯供应商，单价85元/组，性价比高' },
      { name: '四川电解液厂', type: 'supplier', pos: [-1, -0.8, -3], desc: '电解液供应商，日产能294桶，单价400元' },
      { name: '贵阳电解液厂', type: 'supplier', pos: [0.5, 0, -2.5], desc: '电解液供应商，单价430元/桶' },
      { name: '常州壳体厂', type: 'supplier', pos: [3, 0.3, -0.5], desc: '壳体供应商，日产能1920个' },
      { name: '东莞壳体厂', type: 'supplier', pos: [2.5, -0.5, 2.5], desc: '壳体供应商，单价26元/个，价格最优' },
      { name: '广州PACK厂', type: 'factory', pos: [-0.5, 1, 0.5], desc: '华南PACK厂，日产能1442套，60天最大86520套' },
      { name: '苏州PACK厂', type: 'factory', pos: [1.5, 0.8, -0.5], desc: '华东PACK厂，日产能1751套，60天最大105060套' },
      { name: '华北总代', type: 'sales', pos: [-2.5, 0, 4], desc: '华北销售网点（供应华北汽车主机厂+植保无人机客户），月均约24000套，人民币结算' },
      { name: '华中总代', type: 'sales', pos: [0, -0.3, 4.5], desc: '华中销售网点（供应华中新能源汽车基地+巡检无人机客户），月均约28000套，需求量最大' },
      { name: '日本总代', type: 'sales', pos: [4.5, 0.5, -2], desc: '跨境销售网点，日元结算，需海运运输' },
      { name: '西北总代', type: 'sales', pos: [-4, -0.2, -3], desc: '西北销售网点（供应西北低空经济无人机集群+特种车辆），月均约15500套' }
    ];

    // 追加锂电多式联运枢纽（国际码头 / 铁路中转节点）
    (MASTER_DATA.hubs || []).forEach(function(h){
      nodes.push({ name: h.id, type: 'hub', pos: [h.x, 0.2, h.z], desc: h.info });
    });
    const colorMap = { supplier: 0xffaa44, factory: 0x00ff88, sales: 0x44aaff, hub: 0xaa88ff };
    const meshes = [];

    nodes.forEach((n) => {
      const color = colorMap[n.type];
      const size = n.type === 'factory' ? 0.5 : n.type === 'supplier' ? 0.38 : (n.type === 'hub' ? 0.26 : 0.32);
      // V2 风格：工厂=方块 / 网点=柱体 / 供应商=球体
      let geo;
      if (n.type === 'factory') geo = new THREE.BoxGeometry(size*1.5, size*1.9, size*1.5);
      else if (n.type === 'sales') geo = new THREE.CylinderGeometry(size, size*1.25, size*1.7, 20);
      else if (n.type === 'hub') geo = new THREE.OctahedronGeometry(size*1.2, 0);
      else geo = new THREE.SphereGeometry(size, 22, 16);
      const mat = new THREE.MeshStandardMaterial({ color: color, emissive: color, emissiveIntensity: n.type === 'factory' ? 0.55 : 0.4, roughness: 0.35, metalness: 0.5 });
      const mesh = new THREE.Mesh(geo, mat);
      mesh.position.set(n.pos[0], n.pos[1], n.pos[2]);
      mesh.castShadow = true;
      mesh.userData = n;
      scene.add(mesh);
      meshes.push(mesh);

      const ringGeo = new THREE.RingGeometry(size*1.5, size*2.1, 24);
      const ringMat = new THREE.MeshBasicMaterial({ color: color, transparent: true, opacity: 0.22, side: THREE.DoubleSide });
      const ring = new THREE.Mesh(ringGeo, ringMat);
      ring.rotation.x = -Math.PI/2;
      ring.position.set(n.pos[0], n.pos[1]-size-0.05, n.pos[2]);
      scene.add(ring);

      // V2 风格标签：深色圆角底 + 青色描边
      const label = makeDynamicSprite({ text: n.name, color: '#9fe8ff' });
      label.position.set(n.pos[0], n.pos[1]+size+0.75, n.pos[2]);
      scene.add(label);
    });

    // V2 风格：地面大区名（西北区/华北区/华中区/日本）
    const regions = [
      { t:'西北区', p:[-4.3,-0.4,-3.2], s:2.7 },
      { t:'华北区', p:[-2.7,-0.4,3.5], s:2.7 },
      { t:'华中区', p:[0.2,-0.4,4.7], s:2.7 },
      { t:'日本',   p:[4.7,-0.4,-2.3], s:2.2 }
    ];
    regions.forEach(function(r){
      const cv = document.createElement('canvas'); cv.width = 256; cv.height = 128;
      const cx = cv.getContext('2d');
      cx.clearRect(0, 0, 256, 128);
      cx.fillStyle = 'rgba(0,210,255,0.14)';
      cx.font = '700 92px "Microsoft YaHei",sans-serif';
      cx.textAlign = 'center'; cx.textBaseline = 'middle';
      cx.fillText(r.t, 128, 64);
      const tex = new THREE.CanvasTexture(cv);
      const sp = new THREE.Sprite(new THREE.SpriteMaterial({ map: tex, transparent: true, depthWrite: false }));
      sp.position.set(r.p[0], r.p[1], r.p[2]);
      sp.scale.set(r.s, r.s * 0.5, 1);
      scene.add(sp);
    });

    // 连接线路：按锂电多式联运路线绘制（途经港口/铁路枢纽）+ 已选路线高亮与车辆行驶
    const vehicles = [];
    const selRoutes = (state.selectedRoutes || {});
    MASTER_DATA.routes.forEach(function(r){
      const legs = r.legs || [r.from, r.to];
      const pts = legs.map(function(nm){
        const nd = nodes.find(n => n.name === nm);
        if (!nd) return null;
        return new THREE.Vector3(nd.pos[0], nd.pos[1], nd.pos[2]);
      }).filter(Boolean);
      if (pts.length < 2) return;
      const sel = !!selRoutes[r.id];
      let curve;
      if (pts.length === 2) {
        const mid = pts[0].clone().add(pts[1]).multiplyScalar(0.5);
        mid.y += 0.25 + pts[0].distanceTo(pts[1]) * 0.025;
        curve = new THREE.QuadraticBezierCurve3(pts[0], mid, pts[1]);
      } else {
        curve = new THREE.CatmullRomCurve3(pts, false, 'catmullrom', 0.25);
      }
      const hp = curve.getPoints(44);
      scene.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(hp),
        new THREE.LineBasicMaterial({ color: sel ? 0xffee44 : 0x00d2ff, transparent: true, opacity: sel ? 0.65 : 0.16 })));
      if (!sel) return;
      const vm = new THREE.Mesh(new THREE.BoxGeometry(0.11, 0.11, 0.28),
        new THREE.MeshStandardMaterial({ color: 0xffee44, emissive: 0xffaa00, emissiveIntensity: 0.75 }));
      vm.userData = { curve: curve, t: Math.random(), speed: 0.028 + Math.random()*0.018 };
      scene.add(vm);
      vehicles.push(vm);
    });

    // OrbitControls 不可达时降级：不启用阻尼与自动旋转，地图仍可交互
    const controls = (typeof THREE.OrbitControls === 'function')
      ? new THREE.OrbitControls(camera, renderer.domElement)
      : null;
    if (controls) {
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.autoRotate = true;
    controls.autoRotateSpeed = 0.5;
    controls.target.set(0, 0.3, 0);
    controls.enableZoom = true;
    controls.minDistance = 5;
    controls.maxDistance = 20;
    }

    // 点击节点显示信息
    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2();
    let popup = null;
    renderer.domElement.addEventListener('click', (e) => {
      const rect = renderer.domElement.getBoundingClientRect();
      mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
      raycaster.setFromCamera(mouse, camera);
      const intersects = raycaster.intersectObjects(meshes);
      if (intersects.length > 0) {
        const n = intersects[0].object.userData;
        if (!popup) {
          popup = document.createElement('div');
          popup.className = 'node-info-popup';
          container.appendChild(popup);
        }
        popup.style.display = 'block';
        popup.style.left = (e.clientX - rect.left + 10) + 'px';
        popup.style.top = (e.clientY - rect.top + 10) + 'px';
        popup.innerHTML = '<h5>'+n.name+'</h5><p>'+n.desc+'</p><p style="margin-top:0.3rem; color:#00d2ff; font-size:0.7rem;">类型：'+n.type+'</p>';
      } else {
        if (popup) popup.style.display = 'none';
      }
    });

    function animate() {
      window.__supplierRaf = requestAnimationFrame(animate);
      vehicles.forEach(v => {
        v.userData.t = (v.userData.t + v.userData.speed) % 1;
        const p = v.userData.curve.getPoint(v.userData.t);
        v.position.copy(p);
        v.lookAt(v.userData.curve.getPoint(Math.min(v.userData.t + 0.02, 1)));
      });
      if (controls && typeof controls.update === 'function') controls.update();
      renderer.render(scene, camera);
    }
    animate();

    const resize = () => {
      const w = container.clientWidth, h = container.clientHeight;
      if (w > 0 && h > 0) { camera.aspect = w/h; camera.updateProjectionMatrix(); renderer.setSize(w, h); }
    };
    window.addEventListener('resize', resize);
    new ResizeObserver(resize).observe(container);
  }



  /* =====================================================
   * 以下为 EM蓄电池 V2 移植模块：3D 场景工具箱 / 工厂产线 /
   * 蓄电池拆解 / 评分翻转卡 / 运费运营汇总（数据已换为 HF 案例）
   * ===================================================== */
  var HF_HAS_THREE = (typeof THREE !== 'undefined');

  // ---------- 场景工具箱（V2 SceneKit） ----------
  function SceneKit(container, opts){
    opts = opts || {};
    var kit = {
      scene: new THREE.Scene(), camera: null, renderer: null, controls: null,
      raf: 0, running: true, clickables: [], width: 0, height: 0
    };
    kit.scene.background = new THREE.Color(0x050d18);
    kit.scene.fog = new THREE.Fog(0x050d18, 14, 34);
    kit.camera = new THREE.PerspectiveCamera(opts.fov || 42, 1, 0.1, 200);
    var cp = opts.camPos || [6, 4.5, 9];
    kit.camera.position.set(cp[0], cp[1], cp[2]);
    kit.renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });
    kit.renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    container.appendChild(kit.renderer.domElement);
    kit.scene.add(new THREE.AmbientLight(0x93a7c4, 0.75));
    var dl = new THREE.DirectionalLight(0xffffff, 0.95); dl.position.set(5, 9, 6); kit.scene.add(dl);
    var fl = new THREE.DirectionalLight(0x4d9fff, 0.45); fl.position.set(-4, 3, -5); kit.scene.add(fl);
    if (THREE.OrbitControls) {
      kit.controls = new THREE.OrbitControls(kit.camera, kit.renderer.domElement);
      kit.controls.enableDamping = true;
      kit.controls.dampingFactor = 0.08;
      kit.controls.autoRotate = !!opts.autoRotate;
      kit.controls.autoRotateSpeed = opts.autoRotateSpeed || 0.4;
      kit.controls.minDistance = opts.minDistance || 3;
      kit.controls.maxDistance = opts.maxDistance || 24;
      kit.controls.maxPolarAngle = opts.maxPolarAngle || Math.PI / 2.05;
      if (opts.target) kit.controls.target.set(opts.target[0], opts.target[1], opts.target[2]);
    }
    kit.resize = function(){
      var w = container.clientWidth, h = container.clientHeight;
      if (!w || !h) return;
      kit.width = w; kit.height = h;
      kit.camera.aspect = w / h;
      kit.camera.updateProjectionMatrix();
      kit.renderer.setSize(w, h);
    };
    kit.resize();
    var ro = null;
    if (window.ResizeObserver) { ro = new ResizeObserver(kit.resize); ro.observe(container); }
    kit.loop = function(fn){
      var last = performance.now();
      function frame(t){
        if (!kit.running) return;
        kit.raf = requestAnimationFrame(frame);
        var dt = Math.min((t - last) / 1000, 0.1); last = t;
        if (kit.controls) kit.controls.update();
        fn(dt, t / 1000);
        kit.renderer.render(kit.scene, kit.camera);
      }
      kit.raf = requestAnimationFrame(frame);
    };
    kit.dispose = function(){
      kit.running = false;
      cancelAnimationFrame(kit.raf);
      if (ro) ro.disconnect();
      if (kit.controls) kit.controls.dispose();
      try { kit.renderer.dispose(); } catch(e){}
      if (kit.renderer.domElement.parentNode) kit.renderer.domElement.parentNode.removeChild(kit.renderer.domElement);
    };
    return kit;
  }

  // ---------- 点击拾取（V2 kitPick） ----------
  function kitPick(kit, cb){
    if (!kit.renderer) return;
    var ray = new THREE.Raycaster(), v = new THREE.Vector2();
    kit.renderer.domElement.addEventListener('click', function(e){
      var rect = kit.renderer.domElement.getBoundingClientRect();
      v.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      v.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
      ray.setFromCamera(v, kit.camera);
      var hits = ray.intersectObjects(kit.clickables, false);
      if (hits.length) cb(hits[0].object, e);
    });
    kit.renderer.domElement.addEventListener('pointermove', function(e){
      var rect = kit.renderer.domElement.getBoundingClientRect();
      v.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      v.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
      ray.setFromCamera(v, kit.camera);
      var hits = ray.intersectObjects(kit.clickables, false);
      kit.renderer.domElement.style.cursor = hits.length ? 'pointer' : 'grab';
    });
  }

  // ---------- 文字精灵（V2 makeTextSprite） ----------
  function makeTextSprite(text, opt){
    opt = opt || {};
    var fontSize = opt.size || 30;
    var canvas = document.createElement('canvas');
    var ctx = canvas.getContext('2d');
    var font = '700 ' + fontSize + 'px "Microsoft YaHei","PingFang SC",sans-serif';
    ctx.font = font;
    var w = Math.ceil(ctx.measureText(text).width) + (opt.pad === undefined ? 18 : opt.pad);
    var h = fontSize + (opt.pad === undefined ? 14 : opt.pad);
    canvas.width = w; canvas.height = h;
    ctx.font = font;
    if (opt.bg !== false) {
      ctx.fillStyle = opt.bg || 'rgba(5,14,28,.78)';
      var r = 8;
      ctx.beginPath();
      ctx.moveTo(r, 0); ctx.lineTo(w - r, 0); ctx.quadraticCurveTo(w, 0, w, r);
      ctx.lineTo(w, h - r); ctx.quadraticCurveTo(w, h, w - r, h);
      ctx.lineTo(r, h); ctx.quadraticCurveTo(0, h, 0, h - r);
      ctx.lineTo(0, r); ctx.quadraticCurveTo(0, 0, r, 0);
      ctx.fill();
      if (opt.border) { ctx.strokeStyle = opt.border; ctx.lineWidth = 1.5; ctx.stroke(); }
    }
    ctx.fillStyle = opt.color || '#cfe8ff';
    ctx.textBaseline = 'middle';
    ctx.fillText(text, (opt.pad === undefined ? 9 : opt.pad / 2), h / 2);
    var tex = new THREE.CanvasTexture(canvas);
    tex.minFilter = THREE.LinearFilter;
    var sp = new THREE.Sprite(new THREE.SpriteMaterial({ map: tex, transparent: true, depthWrite: false, opacity: opt.opacity || 1 }));
    var s = opt.scale || 0.34;
    sp.scale.set(w / h * s, s, 1);
    return sp;
  }

  // ---------- 动态文字精灵（V2 makeDynamicSprite） ----------
  function makeDynamicSprite(opt){
    opt = opt || {};
    var canvas = document.createElement('canvas');
    canvas.width = 512; canvas.height = 96;
    var ctx = canvas.getContext('2d');
    var tex = new THREE.CanvasTexture(canvas);
    tex.minFilter = THREE.LinearFilter;
    var sp = new THREE.Sprite(new THREE.SpriteMaterial({ map: tex, transparent: true, depthWrite: false }));
    sp.scale.set(512 / 96 * 0.5, 0.5, 1);
    sp.setText = function(text, color){
      ctx.clearRect(0, 0, 512, 96);
      ctx.font = '700 40px "Microsoft YaHei",sans-serif';
      var w = ctx.measureText(text).width;
      ctx.fillStyle = 'rgba(5,14,28,.8)';
      var r = 14;
      ctx.beginPath();
      ctx.moveTo(256 - w/2 - 18 + r, 16); ctx.lineTo(256 + w/2 + 18 - r, 16);
      ctx.quadraticCurveTo(256 + w/2 + 18, 16, 256 + w/2 + 18, 16 + r);
      ctx.lineTo(256 + w/2 + 18, 80 - r); ctx.quadraticCurveTo(256 + w/2 + 18, 80, 256 + w/2 + 18 - r, 80);
      ctx.lineTo(256 - w/2 - 18 + r, 80); ctx.quadraticCurveTo(256 - w/2 - 18, 80, 256 - w/2 - 18, 80 - r);
      ctx.lineTo(256 - w/2 - 18, 16 + r); ctx.quadraticCurveTo(256 - w/2 - 18, 16, 256 - w/2 - 18 + r, 16);
      ctx.fill();
      ctx.strokeStyle = 'rgba(0,210,255,.5)'; ctx.lineWidth = 2; ctx.stroke();
      ctx.fillStyle = color || '#9fe8ff';
      ctx.textBaseline = 'middle';
      ctx.fillText(text, 256 - w / 2, 50);
      tex.needsUpdate = true;
    };
    sp.setText(opt.text || '', opt.color);
    return sp;
  }

  // ---------- 评分标准翻转卡（V2 交互） ----------
  function initFlipCards(){
    var cards = document.querySelectorAll('#stepContent .flip');
    for (var i = 0; i < cards.length; i++){
      (function(c){ c.addEventListener('click', function(){ c.classList.toggle('flipped'); }); })(cards[i]);
    }
  }

  // ---------- 3D 工厂产线（V2 移植，HF 数据） ----------
  function mountFactoryScene(container){
    if (!HF_HAS_THREE || !container) return null;
    var kit = SceneKit(container, { fov: 40, camPos: [0, 3.4, 6.6], target: [0, 0.35, 0], autoRotate: true, autoRotateSpeed: 0.35, minDistance: 4, maxDistance: 12 });
    var ground = new THREE.Mesh(new THREE.PlaneGeometry(20, 20), new THREE.MeshStandardMaterial({ color: 0x070f1d, roughness: 0.95 }));
    ground.rotation.x = -Math.PI / 2; kit.scene.add(ground);
    var grid = new THREE.GridHelper(12, 24, 0x11406b, 0x0a2138);
    grid.material.transparent = true; grid.material.opacity = 0.5; kit.scene.add(grid);
    var crates = [];
    function makeFactory(x, name, color){
      var g = new THREE.Group();
      var base = new THREE.Mesh(new THREE.BoxGeometry(1.5, 0.72, 1.15),
        new THREE.MeshStandardMaterial({ color: 0x14304d, roughness: 0.5, metalness: 0.4 }));
      base.position.y = 0.36; g.add(base);
      var roof = new THREE.Mesh(new THREE.BoxGeometry(1.62, 0.09, 1.26),
        new THREE.MeshStandardMaterial({ color: color, emissive: color, emissiveIntensity: 0.35, roughness: 0.4 }));
      roof.position.y = 0.76; g.add(roof);
      for (var i = 0; i < 3; i++) {
        var win = new THREE.Mesh(new THREE.BoxGeometry(0.26, 0.2, 0.03),
          new THREE.MeshStandardMaterial({ color: 0xffc46b, emissive: 0xffaa33, emissiveIntensity: 0.9 }));
        win.position.set(-0.45 + i * 0.45, 0.45, 0.59); g.add(win);
      }
      var chimney = new THREE.Mesh(new THREE.CylinderGeometry(0.08, 0.1, 0.55, 10),
        new THREE.MeshStandardMaterial({ color: 0x2a3a55 }));
      chimney.position.set(0.5, 1.05, -0.35); g.add(chimney);
      var belt = new THREE.Mesh(new THREE.BoxGeometry(1.8, 0.05, 0.3),
        new THREE.MeshStandardMaterial({ color: 0x0e2a44, emissive: 0x0a2036, emissiveIntensity: 0.4 }));
      belt.position.set(0, 0.12, 0.85); g.add(belt);
      var label = makeDynamicSprite({ text: name, color: '#9fe8ff' });
      label.position.set(0, 1.35, 0); g.add(label);
      g.position.x = x;
      kit.scene.add(g);
      return { group: g, label: label, spawn: 0 };
    }
    // HF 案例：广州PACK厂 / 苏州PACK厂
    var f1 = makeFactory(-1.5, '广州PACK厂', 0x00d2ff);
    var f2 = makeFactory( 1.5, '苏州PACK厂', 0x00ff88);
    function crateFactory(color){
      return new THREE.Mesh(new THREE.BoxGeometry(0.13, 0.09, 0.13),
        new THREE.MeshStandardMaterial({ color: color, emissive: color, emissiveIntensity: 0.5, roughness: 0.4 }));
    }
    var api = {
      setRates: function(gz, sz){
        f1.label.setText('广州PACK厂 · 日产 ' + gz + ' 套');
        f2.label.setText('苏州PACK厂 · 日产 ' + sz + ' 套');
        f1.rate = Math.max(0.15, Math.min(5, gz / 150));
        f2.rate = Math.max(0.15, Math.min(5, sz / 150));
      }
    };
    kit.loop(function(dt){
      [f1, f2].forEach(function(f, idx){
        if (!f.rate) return;
        f.spawn += dt * f.rate;
        if (f.spawn >= 1) {
          f.spawn = 0;
          var c = crateFactory(idx === 0 ? 0x00d2ff : 0x00ff88);
          c.position.set(f.group.position.x - 0.8, 0.19, 0.85);
          c.userData.limit = f.group.position.x + 0.95;
          kit.scene.add(c);
          crates.push(c);
        }
      });
      for (var i = crates.length - 1; i >= 0; i--) {
        crates[i].position.x += dt * 0.7;
        if (crates[i].position.x > crates[i].userData.limit) {
          kit.scene.remove(crates[i]);
          crates.splice(i, 1);
        }
      }
    });
    api.dispose = function(){ kit.dispose(); };
    window.__factoryScene = api;
    refreshFactoryRates();
    return api;
  }

  // 计划产量变化时刷新工厂 3D 标签
  function refreshFactoryRates(){
    if (!window.__factoryScene || !window.__factoryScene.setRates) return;
    var p = state.productionPlan || {};
    var gz = Math.round((p['广州PACK厂'] || 0) / 60);
    var sz = Math.round((p['苏州PACK厂'] || 0) / 60);
    window.__factoryScene.setRates(gz, sz);
  }
  if (!window.__hfProdListener) {
    window.__hfProdListener = true;
    document.addEventListener('input', function(e){
      if (e.target && /_prod$/.test(e.target.id || '')) refreshFactoryRates();
    });
  }

  // ---------- 3D 蓄电池拆解（V2 圆柱爆炸，HF 部件体系） ----------
  function mountBatteryScene(container, slider, infoEl){
    if (!HF_HAS_THREE || !container) return null;
    var kit = SceneKit(container, { fov: 38, camPos: [0, 1.9, 4.6], target: [0, 0.05, 0], autoRotate: true, autoRotateSpeed: 0.7, minDistance: 2.6, maxDistance: 8 });
    var root = new THREE.Group();
    kit.scene.add(root);

    // 铝合金壳体（开放圆柱）
    var shellMat = new THREE.MeshStandardMaterial({ color: 0x2f7fb8, transparent: true, opacity: 0.28, roughness: 0.2, metalness: 0.5, side: THREE.DoubleSide });
    var shell = new THREE.Mesh(new THREE.CylinderGeometry(0.5, 0.5, 1.15, 32, 1, true), shellMat);
    root.add(shell);
    var capTop = new THREE.Mesh(new THREE.CylinderGeometry(0.5, 0.5, 0.04, 32), new THREE.MeshStandardMaterial({ color: 0x3a5a7a, roughness: 0.4 }));
    capTop.position.y = 0.575; root.add(capTop);
    var capBot = capTop.clone(); capBot.position.y = -0.575; root.add(capBot);
    var term1 = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.05, 0.14, 12), new THREE.MeshStandardMaterial({ color: 0xffb347, emissive: 0xcc8800, emissiveIntensity: 0.6 }));
    term1.position.set(-0.14, 0.66, 0); root.add(term1);
    var term2 = term1.clone(); term2.position.x = 0.14; root.add(term2);

    // 电解液
    var elecMat = new THREE.MeshStandardMaterial({ color: 0x2dd4bf, transparent: true, opacity: 0.16, roughness: 0.1 });
    var electrolyte = new THREE.Mesh(new THREE.CylinderGeometry(0.43, 0.43, 0.92, 26), elecMat);
    root.add(electrolyte);

    // 电芯模组 ×2 组（6 片）
    var plates = [];
    var plateMatA = new THREE.MeshStandardMaterial({ color: 0xff9a4d, emissive: 0x994400, emissiveIntensity: 0.35, roughness: 0.35, metalness: 0.6 });
    var plateMatB = new THREE.MeshStandardMaterial({ color: 0xffd76e, emissive: 0xaa7700, emissiveIntensity: 0.3, roughness: 0.35, metalness: 0.6 });
    for (var i = 0; i < 6; i++) {
      var p = new THREE.Mesh(new THREE.BoxGeometry(0.34, 0.78, 0.028), i % 2 ? plateMatB : plateMatA);
      p.userData = { part: 'cells' };
      root.add(p);
      plates.push(p);
    }

    // HF 案例扩展部件：BMS / 热管理 / 铝合金托盘
    var bms = new THREE.Mesh(new THREE.BoxGeometry(0.34, 0.16, 0.22), new THREE.MeshStandardMaterial({ color: 0x33ff99, emissive: 0x0a7a4a, emissiveIntensity: 0.5, roughness: 0.35, metalness: 0.5 }));
    bms.position.set(0, 0.46, 0.34); bms.userData = { part: 'bms' }; root.add(bms);
    var thermal = new THREE.Mesh(new THREE.BoxGeometry(0.62, 0.05, 0.42), new THREE.MeshStandardMaterial({ color: 0xff4455, emissive: 0x8a1020, emissiveIntensity: 0.45, roughness: 0.4, metalness: 0.4 }));
    thermal.position.set(0, -0.44, 0); thermal.userData = { part: 'thermal' }; root.add(thermal);
    var tray = new THREE.Mesh(new THREE.BoxGeometry(0.92, 0.07, 0.66), new THREE.MeshStandardMaterial({ color: 0xbbbbbb, roughness: 0.45, metalness: 0.6 }));
    tray.position.set(0, -0.63, 0); tray.userData = { part: 'tray' }; root.add(tray);

    // 标签（HF BOM 口径）
    var lbShell = makeTextSprite('铝合金壳体 ×1个', { size: 24, scale: 0.24, color: '#9fe8ff' });
    lbShell.position.set(0, 1.0, 0); root.add(lbShell);
    var lbElec = makeTextSprite('电解液 ×0.1桶', { size: 24, scale: 0.24, color: '#9ff5e8' });
    lbElec.position.set(0, -0.85, 0); root.add(lbElec);
    var lbPlates = makeTextSprite('电芯模组 ×2组', { size: 24, scale: 0.24, color: '#ffd9b0' });
    lbPlates.position.set(0.85, 0, 0); root.add(lbPlates);
    var lbBms = makeTextSprite('BMS ×1套', { size: 22, scale: 0.22, color: '#b6ffd8' });
    lbBms.position.set(0.55, 0.72, 0.5); root.add(lbBms);
    var lbThermal = makeTextSprite('热管理 ×1套', { size: 22, scale: 0.22, color: '#ffc2c8' });
    lbThermal.position.set(-0.6, -0.7, 0.25); root.add(lbThermal);
    var lbTray = makeTextSprite('铝合金托盘 ×1个', { size: 22, scale: 0.22, color: '#e2e6ea' });
    lbTray.position.set(0, -1.05, 0.2); root.add(lbTray);

    var PART_INFO = {
      shell: { t: '铝合金壳体（PACK 外壳）', d: '每套 PACK 消耗 1 个。最低单价 ¥26/个（东莞壳体厂），承担结构防护与密封，需与托盘可靠连接。' },
      cells: { t: '电芯模组（磷酸铁锂 / 三元锂）', d: '每套消耗 2 组。最低单价 ¥85/组（宝鸡电芯厂），占采购成本约 72%，是降本关键。车载版用磷酸铁锂（长寿命），无人机版用三元锂（高能量密度）。' },
      elec:  { t: '电解液（LiPF6 + 碳酸酯溶剂）', d: '每套消耗 0.1 桶。最低单价 ¥400/桶（四川电解液厂），属危险化学品，运输需专用容器与合规资质。' },
      bms:   { t: 'BMS 电池管理系统', d: '采集电压与温度、估算 SOC、做均衡与充放电保护，是电池 PACK 的核心控制单元。' },
      thermal:{ t: '热管理组件（液冷板 / 换热件）', d: '控制电芯工作温区，防止热失控，保障使用安全与循环寿命。' },
      tray:  { t: '铝合金托盘（CTP/CTC 结构件）', d: '承载电芯模组与 BMS，是交付整车厂 / 无人机整机厂的完整高压系统底座；CTP/CTC 工艺下电芯直排入包，取消模组外壳以提升体积利用率。' }
    };
    shell.userData = { part: 'shell' }; capTop.userData = { part: 'shell' }; capBot.userData = { part: 'shell' };
    electrolyte.userData = { part: 'elec' };
    kit.clickables = [shell, capTop, capBot, electrolyte, bms, thermal, tray].concat(plates);
    kitPick(kit, function(obj){
      var info = PART_INFO[obj.userData.part];
      if (info && infoEl) {
        infoEl.innerHTML = '<h4><i class="fas fa-info-circle"></i> ' + info.t + '</h4><p style="line-height:1.75;">' + info.d + '</p>';
      }
    });

    function explode(k){
      shell.position.y = 0.95 * k;
      capTop.position.y = 0.575 + 0.95 * k;
      capBot.position.y = -0.575 + 0.95 * k;
      term1.position.y = 0.66 + 0.95 * k; term2.position.y = 0.66 + 0.95 * k;
      lbShell.position.y = 1.0 + 0.95 * k;
      electrolyte.position.y = -0.6 * k;
      elecMat.opacity = 0.16 * (1 - k * 0.45);
      lbElec.position.y = -0.85 - 0.6 * k;
      plates.forEach(function(p, idx){
        var off = (idx - 2.5) * 0.17 * k;
        p.position.x = off;
        p.rotation.y = off * 0.6;
      });
      lbPlates.position.x = 0.55 + 0.5 * k;
      bms.position.y = 0.46 + 0.75 * k;
      lbBms.position.y = 0.72 + 0.75 * k;
      thermal.position.y = -0.44 - 0.55 * k;
      lbThermal.position.y = -0.7 - 0.55 * k;
      tray.position.y = -0.63 - 1.0 * k;
      lbTray.position.y = -1.05 - 1.0 * k;
      var o = Math.max(0, Math.min(1, k * 1.6 - 0.25));
      lbShell.material.opacity = o; lbElec.material.opacity = o; lbPlates.material.opacity = o;
      lbBms.material.opacity = o; lbThermal.material.opacity = o; lbTray.material.opacity = o;
    }
    explode(0.4);
    if (slider) slider.addEventListener('input', function(){
      var v = parseInt(slider.value, 10) || 0;
      explode(v / 100);
      var out = document.getElementById('explodeVal'); if (out) out.textContent = v;
    });
    kit.loop(function(){});
    var api = { dispose: function(){ kit.dispose(); }, explode: explode };
    window.__batteryScene = api;
    return api;
  }

  // ---------- 运费计算已统一到下方「锂离子PACK 专属内容」区块 ----------

  /* =====================================================
   * 锂离子PACK 专属内容 + EM 平台展现方式移植
   * ===================================================== */
  var HF_ROUTE_FILTER = 'all';

  // ---------- 锂离子电池核心概念（翻转卡） ----------
  function hfConcepts(){
    return [
      { ic:'fa-layer-group', t:'CTP / CTC 无模组化', s:'电芯直排入包，取消模组外壳',
        b:'CTP（Cell to Pack）与 CTC（Cell to Chassis）把<b>电芯直接排入电池包/底盘</b>，省去模组外壳与结构件。PACK 更轻、空间利用率更高 → <b>整车续航与物流计费重同步下降</b>，是锂电 PACK 最关键的集成路线。' },
      { ic:'fa-brain', t:'BMS 与 SOC 估算', s:'电压/温度采集、均衡与保护',
        b:'BMS 采集电芯电压与温度、估算 SOC/SOH、做电芯均衡与过充过放保护，并管理<b>高压继电器</b>。它是 PACK 的大脑——本平台 PACK 层级中已单列 BMS 部件。' },
      { ic:'fa-fire-extinguisher', t:'热失控与热管理', s:'隔膜/电解液/液冷板共同守住安全边界',
        b:'锂电安全由<b>隔膜、电解液、BMS 与热管理</b>共同决定：内短路或过充会引发热失控。PACK 必须配液冷板/换热件控温，热管理失效将直接放大风险。' },
      { ic:'fa-code-branch', t:'磷酸铁锂 vs 三元锂', s:'车载长寿命 / 无人机高能量密度',
        b:'本平台双技术路线：<b>磷酸铁锂</b>循环寿命长、热稳定好、成本低 → 车载 PACK；<b>三元锂</b>能量密度高、低温性能好 → 无人机 PACK。同样的电芯/电解液/壳体 BOM，两条路线的成本与供应链不同。' },
      { ic:'fa-recycle', t:'梯次利用与回收闭环', s:'退役PACK → 梯次/材料回收',
        b:'退役 PACK 并非立刻报废：<b>梯次利用</b>降级用于储能/备电，<b>材料回收</b>回收锂、镍、钴。步骤9 的「电池回收率」即模拟该闭环，为企业带来残值收入并降低碳排放强度。' }
    ];
  }

  // ---------- 物流节点登记表（含港口/铁路枢纽） ----------
  function hfLogiRegistry(){
    var reg = {};
    var supPos = {
      '石家庄电芯厂': [-4.3, 1.5], '宝鸡电芯厂': [-4.5, -0.4],
      '四川电解液厂': [-3.1, -2.3], '贵阳电解液厂': [-3.6, -3.1],
      '常州壳体厂': [-1.7, -3.3], '东莞壳体厂': [-2.1, -1.2]
    };
    MASTER_DATA.suppliers.forEach(function(s){
      var p = supPos[s.id] || [-3, 0];
      var u = s.material === '电芯' ? '组' : (s.material === '电解液' ? '桶' : '个');
      reg[s.id] = { x:p[0], z:p[1], type:'sup',
        desc: s.material + '供应商 · 日产 ' + s.daily + ' ' + u + ' · ¥' + s.price + '/' + u };
    });
    MASTER_DATA.factories.production.forEach(function(f, i){
      var p = i === 0 ? [-0.4, 0.2] : [1.4, -1.4];
      reg[f.factory] = { x:p[0], z:p[1], type:'fac',
        desc: 'PACK 工厂 · 日产 ' + f.daily + ' 套 · 60天最大产能 ' + f.total.toLocaleString() + ' 套' };
    });
    var salesPos = { '华北总代':[-2.4, 3.6], '华中总代':[0.2, 4.2], '西北总代':[-4.6, 2.6], '日本总代':[4.4, -2.2] };
    MASTER_DATA.salesPoints.forEach(function(p){
      var q = salesPos[p.id] || [0, 3];
      reg[p.id] = { x:q[0], z:q[1], type:'sales',
        desc: '销售网点 · 60天预测 ' + p.forecast.toLocaleString() + ' 套 · 库存上限 ' + p.cap.toLocaleString() + ' 套 · ' + p.currency };
    });
    (MASTER_DATA.hubs || []).forEach(function(h){ reg[h.id] = { x:h.x, z:h.z, type:'hub', desc:h.info }; });
    return reg;
  }
  function hfNodeColor(type){
    if (type === 'fac') return '#00ff88';
    if (type === 'sup') return '#ffaa44';
    if (type === 'sales') return '#44aaff';
    if (type === 'hub') return '#aa88ff';
    return '#00d2ff';
  }
  function hfNodeShape(type){
    if (type === 'fac') return 'box';
    if (type === 'hub') return 'diamond';
    return 'circle';
  }

  // ---------- 运费：MAX(起步价, 运输量 × 计费重 × 距离 × 运价) ----------
  function hfRouteCost(r, qty){
    if (!qty || qty <= 0) return 0;
    return Math.max(r.minFee || 0, qty * r.conv * r.dist * r.rate);
  }
  function hfRouteSummary(){
    var s = { prodCost:0, matCost:0, total:0, prodQty:0, matQty:0, prodCnt:0, matCnt:0 };
    MASTER_DATA.routes.forEach(function(r){
      if (!state.selectedRoutes || !state.selectedRoutes[r.id]) return;
      var q = parseFloat((state.routeQuantities || {})[r.id] || 0);
      var c = hfRouteCost(r, q);
      if (r.kind === 'product') { s.prodCost += c; s.prodQty += q; s.prodCnt++; }
      else { s.matCost += c; s.matQty += q; s.matCnt++; }
    });
    s.total = s.prodCost + s.matCost;
    return s;
  }
  function hfFmt(n, d){
    if (n === null || n === undefined || isNaN(n)) return '-';
    var p = Math.pow(10, d === undefined ? 0 : d);
    return Math.round(n * p) / p;
  }
  function updateFreightSummary(){
    var s = hfRouteSummary();
    var html =
      '<div class="ops-row"><span>成品运费（工厂→网点）</span><span class="v">¥' + hfFmt(s.prodCost) + '</span></div>' +
      '<div class="ops-row"><span>原料运费（供应商→工厂）</span><span class="v">¥' + hfFmt(s.matCost) + '</span></div>' +
      '<div class="ops-row"><span><strong style="color:#e8f4ff;">总运费</strong></span><span class="v">¥' + hfFmt(s.total) + '</span></div>' +
      '<div class="ops-row"><span>平均每件成品运费</span><span class="v">' + (s.prodQty ? '¥' + hfFmt(s.prodCost / s.prodQty, 2) : '-') + '</span></div>' +
      '<div class="ops-row"><span>成品运输量 / 原料运输量</span><span class="v">' + s.prodQty.toLocaleString() + ' 套 / ' + hfFmt(s.matQty) + '</span></div>' +
      '<div class="ops-note">* 运费 = MAX(起步价, 运输量 × 计费重 × 距离 × 运价)。计费重：电芯 0.05 吨/组、电解液 0.1 吨/桶、壳体 0.2 吨/个、成品 PACK 0.9 吨/套；电解液属危险品，运价 ¥0.60/吨·km。</div>';
    document.querySelectorAll('.freight-sum').forEach(function(el){ el.innerHTML = html; });
    var rr = document.getElementById('recycleSumRow');
    if (rr) {
      var re = parseInt(document.getElementById('recycleSlider')?.value) || 35;
      var soldQty = Math.min(
        Object.values(state.productionPlan || {}).reduce(function(a,b){ return a + (parseFloat(b)||0); }, 0),
        Object.values(state.demandForecast || {}).reduce(function(a,b){ return a + (parseFloat(b)||0); }, 0)
      );
      var income = Math.round(soldQty * (re/100) * 80);
      rr.innerHTML =
        '<div class="ops-row"><span>梯次利用回收收益（残值 ¥80/套）</span><span class="v">¥' + income.toLocaleString() + '</span></div>' +
        '<div class="ops-note">* 回收率 ' + re + '%（步骤9 可调）。退役 PACK 经梯次利用（储能/备电）与材料回收形成闭环，收益可抵扣单位物流成本；同时降低碳排放强度。</div>';
    }
  }
  function hfRefreshRouteCost(id){
    var r = MASTER_DATA.routes.find(function(x){ return x.id === id; });
    if (!r) return;
    var el = document.querySelector('[data-cost="'+id+'"]');
    if (el) el.textContent = '¥' + Math.round(hfRouteCost(r, parseFloat((state.routeQuantities||{})[id] || 0)));
  }
  function hfFilterRoutes(kind, btn){
    HF_ROUTE_FILTER = kind;
    document.querySelectorAll('.route-filter button').forEach(function(b){ b.classList.remove('on'); });
    if (btn) btn.classList.add('on');
    document.querySelectorAll('#routesList .route-item').forEach(function(it){
      it.style.display = (kind === 'all' || it.dataset.kind === kind) ? '' : 'none';
    });
  }

  // ---------- 经济路线推荐（按锂电计费重与运价算单位成本） ----------
  function hfEcoRoutePlan(){
    var totalProd = Object.values(state.productionPlan || {}).reduce(function(a,b){ return a + (parseFloat(b)||0); }, 0);
    var totalDemand = Object.values(state.demandForecast || {}).reduce(function(a,b){ return a + (parseFloat(b)||0); }, 0);
    var matReq = state.materialRequirements || {};
    state.selectedRoutes = {}; state.routeQuantities = {}; state.routeDays = {};
    document.querySelectorAll('.route-item').forEach(function(c){ c.classList.remove('selected'); });
    function pick(cands, qty) {
      if (!cands.length || !qty) return null;
      var best = cands.slice().sort(function(a,b){
        var ca = a.conv * a.dist * a.rate, cb = b.conv * b.dist * b.rate;
        return ca - cb;
      })[0];
      state.selectedRoutes[best.id] = true;
      state.routeQuantities[best.id] = Math.round(qty);
      state.routeDays[best.id] = best.days;
      return best;
    }
    // 成品：按网点需求分配到成本最低的可选路线
    MASTER_DATA.salesPoints.forEach(function(p){
      var cands = MASTER_DATA.routes.filter(function(r){ return r.kind === 'product' && r.to === p.id; });
      var qty = Math.round((state.demandForecast || {})[p.id] || p.forecast || 0);
      pick(cands, qty);
    });
    // 原料：按 BOM 需求量分配到成本最低的路线
    ['电芯','电解液','壳体'].forEach(function(m){
      var need = matReq[m] || 0;
      if (!need) return;
      var cands = MASTER_DATA.routes.filter(function(r){
        return r.kind === 'material' && (r.from.indexOf(m === '电芯' ? '电芯厂' : (m === '电解液' ? '电解液厂' : '壳体厂')) >= 0);
      });
      pick(cands, need);
    });
    // 回填 UI
    document.querySelectorAll('.route-item').forEach(function(card){
      var id = card.dataset.id;
      if (!state.selectedRoutes[id]) return;
      card.classList.add('selected');
      var q = card.querySelector('.route-qty'); if (q) q.value = state.routeQuantities[id] || 0;
      var d = card.querySelector('.route-days'); if (d) d.value = state.routeDays[id] || '';
      hfRefreshRouteCost(id);
    });
    initRouteMap(); updateFreightSummary(); hfRefreshLogiScene();
    toast('已按计费重×运价推荐经济路线：成品按网点需求、原料按 BOM 需求分配');
  }

  // ---------- AI 多式联运规划（锂电口径：成品到网点 + 原料到工厂） ----------
  function hfAiPlanMultimodal(){
    var matReq = state.materialRequirements || {};
    state.selectedRoutes = {}; state.routeQuantities = {}; state.routeDays = {};
    document.querySelectorAll('.route-item').forEach(function(c){ c.classList.remove('selected'); });
    function apply(r, qty, days) {
      state.selectedRoutes[r.id] = true;
      state.routeQuantities[r.id] = Math.round(qty);
      state.routeDays[r.id] = days || r.days;
    }
    // 成品：跨境走海运（成本最低），国内优先汽运（时效），并保留一条铁路备选
    MASTER_DATA.salesPoints.forEach(function(p){
      var cands = MASTER_DATA.routes.filter(function(r){ return r.kind === 'product' && r.to === p.id; });
      if (!cands.length) return;
      var qty = Math.round((state.demandForecast || {})[p.id] || p.forecast || 0);
      var sea = cands.filter(function(r){ return r.mode === '海运'; });
      var road = cands.filter(function(r){ return r.mode === '汽运'; });
      var rail = cands.filter(function(r){ return r.mode === '铁路'; });
      var chosen = null;
      if (sea.length) chosen = sea[0];
      else if (road.length) chosen = road[0];
      else if (rail.length) chosen = rail[0];
      if (chosen) apply(chosen, qty);
      // 时效吃紧的国内网点再补一条铁路备选
      if (!sea.length && rail.length && road.length && qty > 0) {
        apply(rail[0], Math.round(qty * 0.3));
      }
    });
    // 原料：电芯优先铁路（重货大吨位），电解液/壳体走汽运（危化&短途）
    var matPlan = {
      '电芯': { key:'电芯厂', pref:'铁路', share:0.7 },
      '电解液': { key:'电解液厂', pref:'汽运', share:1.0 },
      '壳体': { key:'壳体厂', pref:'汽运', share:1.0 }
    };
    Object.keys(matPlan).forEach(function(m){
      var need = matReq[m] || 0;
      if (!need) return;
      var mp = matPlan[m];
      var cands = MASTER_DATA.routes.filter(function(r){ return r.kind === 'material' && r.from.indexOf(mp.key) >= 0; });
      if (!cands.length) return;
      var pref = cands.filter(function(r){ return r.mode === mp.pref; });
      var first = (pref[0] || cands[0]);
      apply(first, need * mp.share);
      // 第二货源分摊
      var rest = cands.filter(function(r){ return r.id !== first.id; });
      if (rest.length && mp.share < 1) apply(rest[0], need * (1 - mp.share));
    });
    document.querySelectorAll('.route-item').forEach(function(card){
      var id = card.dataset.id;
      if (!state.selectedRoutes[id]) return;
      card.classList.add('selected');
      var q = card.querySelector('.route-qty'); if (q) q.value = state.routeQuantities[id] || 0;
      var d = card.querySelector('.route-days'); if (d) d.value = state.routeDays[id] || '';
      hfRefreshRouteCost(id);
    });
    initRouteMap(); updateFreightSummary(); hfRefreshLogiScene();
    toast('AI已按锂电多式联运规划：成品跨境走海运、电芯走铁路、电解液走危化专车');
  }

  // ---------- 3D 多式联运网络地图（步骤8） ----------
  var HF_LOGI_KIT = null;
  function mountLogiScene3D(container){
    if (!container) return;
    if (HF_LOGI_KIT) { try { HF_LOGI_KIT.dispose(); } catch(e){} HF_LOGI_KIT = null; }
    while (container.firstChild) container.removeChild(container.firstChild);
    if (!HF_HAS_THREE) {
      container.innerHTML = '<div style="height:100%;display:flex;align-items:center;justify-content:center;color:#8a97a6;font-size:0.85rem;text-align:center;padding:1rem;line-height:1.8;">[3D 多式联运网络地图] 3D组件未加载（three.js CDN 不可达）<br><span style="font-size:0.75rem;">运费汇总与路线选择功能不受影响</span></div>';
      return;
    }
    var kit = SceneKit(container, { fov: 42, camPos: [0.4, 7.2, 8.8], target: [0, 0.2, 0], autoRotate: true, autoRotateSpeed: 0.3, minDistance: 7, maxDistance: 24 });
    var ground = new THREE.Mesh(new THREE.PlaneGeometry(24, 24), new THREE.MeshStandardMaterial({ color: 0x070f1d, roughness: 0.95 }));
    ground.rotation.x = -Math.PI / 2; kit.scene.add(ground);
    var grid = new THREE.GridHelper(16, 24, 0x11406b, 0x0a2138);
    grid.material.transparent = true; grid.material.opacity = 0.5; kit.scene.add(grid);
    var reg = hfLogiRegistry();
    var clickables = [];
    Object.keys(reg).forEach(function(nm){
      var nd = reg[nm];
      var color = hfNodeColor(nd.type);
      var size = nd.type === 'fac' ? 0.26 : nd.type === 'hub' ? 0.2 : 0.17;
      var geo;
      if (nd.type === 'fac') geo = new THREE.BoxGeometry(size*1.6, size*2.0, size*1.6);
      else if (nd.type === 'hub') geo = new THREE.OctahedronGeometry(size*1.15, 0);
      else geo = new THREE.SphereGeometry(size, 18, 14);
      var mesh = new THREE.Mesh(geo, new THREE.MeshStandardMaterial({ color: color, emissive: color, emissiveIntensity: nd.type === 'fac' ? 0.55 : 0.4, roughness: 0.35, metalness: 0.5 }));
      mesh.position.set(nd.x, 0.3, nd.z);
      mesh.userData = { name: nm, desc: nd.desc, type: nd.type };
      kit.scene.add(mesh);
      clickables.push(mesh);
      var ring = new THREE.Mesh(new THREE.RingGeometry(size*1.6, size*2.2, 24),
        new THREE.MeshBasicMaterial({ color: color, transparent: true, opacity: 0.22, side: THREE.DoubleSide }));
      ring.rotation.x = -Math.PI/2; ring.position.set(nd.x, 0.04, nd.z);
      kit.scene.add(ring);
      var label = makeDynamicSprite({ text: nm, color: '#9fe8ff' });
      label.position.set(nd.x, size + 0.85, nd.z);
      kit.scene.add(label);
    });
    // 路线（含枢纽途经）
    var vehicles = [];
    MASTER_DATA.routes.forEach(function(r){
      var legs = r.legs || [r.from, r.to];
      var sel = !!(state.selectedRoutes && state.selectedRoutes[r.id]);
      var pts = legs.map(function(nm){
        var nd = reg[nm] || { x:0, z:0 };
        return new THREE.Vector3(nd.x, 0.3, nd.z);
      });
      var curve;
      if (pts.length === 2) {
        var mid = pts[0].clone().add(pts[1]).multiplyScalar(0.5);
        mid.y += 0.12 + pts[0].distanceTo(pts[1]) * 0.02;
        curve = new THREE.QuadraticBezierCurve3(pts[0], mid, pts[1]);
      } else {
        curve = new THREE.CatmullRomCurve3(pts, false, 'catmullrom', 0.25);
      }
      var hp = curve.getPoints(48);
      kit.scene.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(hp),
        new THREE.LineBasicMaterial({ color: sel ? 0xffee44 : 0x00d2ff, transparent: true, opacity: sel ? 0.7 : 0.16 })));
      if (!sel) return;
      var vm = new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.1, 0.26),
        new THREE.MeshStandardMaterial({ color: 0xffee44, emissive: 0xffaa00, emissiveIntensity: 0.75 }));
      vm.userData = { curve: curve, t: Math.random(), speed: 0.03 + Math.random()*0.02 };
      kit.scene.add(vm);
      vehicles.push(vm);
    });
    kit.clickables = clickables;
    var popup = null;
    kitPick(kit, function(obj){
      var ud = obj.userData;
      if (!popup) { popup = document.createElement('div'); popup.className = 'node-info-popup'; container.appendChild(popup); }
      var rect = container.getBoundingClientRect();
      popup.style.display = 'block';
      popup.style.left = (obj.position.x * 18 + 20) + 'px';
      popup.style.top = (obj.position.z * 12 + 20) + 'px';
      popup.innerHTML = '<h5>' + ud.name + '</h5><p>' + ud.desc + '</p>';
    });
    kit.loop(function(){
      vehicles.forEach(function(v){
        v.userData.t = (v.userData.t + v.userData.speed) % 1;
        v.position.copy(v.userData.curve.getPoint(v.userData.t));
        v.lookAt(v.userData.curve.getPoint(Math.min(v.userData.t + 0.02, 1)));
      });
    });
    HF_LOGI_KIT = kit;
  }
  function hfRefreshLogiScene(){
    if (!HF_LOGI_KIT) return;
    try { HF_LOGI_KIT.dispose(); } catch(e){}
    HF_LOGI_KIT = null;
    mountLogiScene3D(document.getElementById('logiScene3d'));
  }

  // ========== 模拟运行 ==========
  function runSimulation() {
    eventResults = [];
    let ei = 0;
    function nextEvent() {
      if (ei < RISK_EVENTS.length) {
        const ev = RISK_EVENTS[ei++];
        toast('Day '+ev.day+'：'+ev.title, 'warn');
        showEventModal(ev, (choice) => {
          eventResults.push({day: ev.day, title: ev.title, choice: choice.text});
          nextEvent();
        });
      } else {
        finishSimulation();
      }
    }
    nextEvent();
  }

  function finishSimulation() {
    const totalDemand = Object.values(state.demandForecast).reduce((a,b)=>a+b,0);
    const totalProd = Object.values(state.productionPlan).reduce((a,b)=>a+b,0);
    const fillRate = Math.min(100, (totalProd/totalDemand)*100).toFixed(1);
    const maxProd = MASTER_DATA.factories.production.reduce((a,f)=>a+f.total,0);
    const prodRate = Math.min(100, (totalProd/maxProd)*100).toFixed(1);
    let totalDev = 0;
    MASTER_DATA.salesPoints.forEach(p => {
      const actual = p.history.reduce((a,b)=>a+b,0)/6;
      totalDev += Math.abs((state.demandForecast[p.id] - actual)/actual);
    });
    const deviationRate = ((totalDev/MASTER_DATA.salesPoints.length)*100).toFixed(1);

    state.simulationResult = {
      unitProcCost: (3.2 + Math.random()*1.6).toFixed(2),
      unitLogCost: (1.0 + Math.random()*1.2).toFixed(2),
      fillRate: fillRate, prodRate: prodRate, deviation: deviationRate,
      procScore: Math.floor(18 + Math.random()*7),
      logScore: Math.floor(18 + Math.random()*7),
      fillScore: Math.floor(14 + Math.random()*6),
      prodScore: Math.floor(10 + Math.random()*5),
      devScore: Math.floor(10 + Math.random()*5),
      totalScore: 0,
      events: eventResults
    };
    state.simulationResult.totalScore = state.simulationResult.procScore + state.simulationResult.logScore +
      state.simulationResult.fillScore + state.simulationResult.prodScore + state.simulationResult.devScore;
    state.simulationRun = true;
    completeStep(9);
    const username = document.getElementById('username')?.value || 'HFAdmin';
    addScoreRecord(username, state.simulationResult.totalScore);
    if (state.simulationResult.totalScore >= 90) fireConfetti();
    toast('60天模拟完成，总分 '+state.simulationResult.totalScore, state.simulationResult.totalScore>=90?'ok':'warn');

    const el = document.getElementById('simResultText');
    if (el) {
      el.classList.remove('hidden');
      let eventsHtml = '';
      if (eventResults.length) {
        eventsHtml = '<div style="margin-top:0.8rem; padding-top:0.8rem; border-top:1px solid #e0e8f0;">' +
          '<h5 style="color:#e67e22; margin-bottom:0.4rem;"><i class="fas fa-list-ul"></i> 风险事件应对记录</h5>' +
          eventResults.map(e => '<p style="font-size:0.82rem; color:#5a6c7d;">Day'+e.day+' '+e.title+' → '+e.choice+'</p>').join('') +
          '</div>';
      }
      el.innerHTML = '<div class="card flow-line"><h4 style="color:#27ae60;"><i class="fas fa-check-circle"></i> 60天动态模拟完成</h4>' +
        '<p style="margin-top:0.5rem;">市场满足率：<strong>'+fillRate+'%</strong> | 生产满足率：<strong>'+prodRate+'%</strong> | 预测偏差：<strong>'+deviationRate+'%</strong></p>' +
        eventsHtml + '</div>';
    }
    document.getElementById('viewResults')?.classList.remove('hidden');
    notify('60天动态模拟完成！成绩已记录。');
  }

  function resetExperiment() {
    state.currentStep = 1;
    state.completedSteps = new Set([1]);
    state.demandForecast = { "华北总代":24000, "华中总代":28000, "日本总代":16500, "西北总代":15500 };
    state.productionPlan = { "广州PACK厂":86520, "苏州PACK厂":105060 };
    state.materialRequirements = { "电芯":0, "电解液":0, "壳体":0 };
    state.selectedSuppliers = {}; state.selectedRoutes = {}; state.routeQuantities = {}; state.routeDays = {};
    state.simulationRun = false; state.simulationResult = null; state.quizScore = 0;
    updateStepUI(); navigateToStep(1);
    notify('实验已重置，可重新开始');
  }

  // ========== 成绩记录 ==========
  function renderScoreRoll() {
    const container = document.getElementById('scoreRollContainer');
    if (!container) return;
    if (scoreRoll.length === 0) { container.innerHTML = '<div style="color:#666; text-align:center; padding:0.5rem;">暂无成绩记录</div>'; return; }
    container.innerHTML = scoreRoll.slice(0, LEDGER_ROWS).map(item =>
      '<div class="score-roll-item"><span class="user"><i class="fas fa-user"></i> '+item.user+'</span>' +
      '<span class="score">'+item.score+'分</span>' +
      '<span style="color:#667; font-size:0.7rem;">'+(item.time ? new Date(item.time).toLocaleString() : '')+'</span></div>'
    ).join('');
  }

  // 最后一步台账表：Excel 风格表格，展示最新 LEDGER_ROWS 条实验记录
  function renderLedger() {
    const table = document.getElementById('ledgerTable');
    if (!table) return;
    const rows = scoreRoll.slice(0, LEDGER_ROWS);
    let html = '<thead><tr>' +
      '<th class="cell-idx">#</th><th>用户名</th><th class="cell-score">总分</th>' +
      '<th>采购成本<br><span class="sub">/25</span></th>' +
      '<th>物流成本<br><span class="sub">/25</span></th>' +
      '<th>市场满足<br><span class="sub">/20</span></th>' +
      '<th>生产满足<br><span class="sub">/15</span></th>' +
      '<th>预测偏差<br><span class="sub">/15</span></th>' +
      '<th>完成时间</th></tr></thead><tbody>';
    if (!rows.length) {
      html += '<tr><td colspan="9" class="cell-empty">暂无实验记录，完成步骤9动态模拟后自动写入本台账</td></tr>';
    } else {
      rows.forEach((r, i) => {
        const cell = v => (v === undefined || v === null || v === '') ? '-' : v;
        html += '<tr>' +
          '<td class="cell-idx">' + (i + 1) + '</td>' +
          '<td class="cell-user">' + (r.user || 'HFAdmin') + '</td>' +
          '<td class="cell-score">' + cell(r.score) + '</td>' +
          '<td>' + cell(r.proc) + '</td>' +
          '<td>' + cell(r.log) + '</td>' +
          '<td>' + cell(r.fill) + '</td>' +
          '<td>' + cell(r.prod) + '</td>' +
          '<td>' + cell(r.dev) + '</td>' +
          '<td class="cell-time">' + fmtTime(r.time) + '</td>' +
        '</tr>';
      });
    }
    html += '</tbody>';
    table.innerHTML = html;
  }

  function addScoreRecord(username, score) {
    const r = state.simulationResult || {};
    scoreRoll.unshift({
      user: username || 'HFAdmin',
      score: (typeof score === 'number') ? score : (r.totalScore || 0),
      time: Date.now(),
      proc: r.procScore, log: r.logScore, fill: r.fillScore, prod: r.prodScore, dev: r.devScore,
      fillRate: r.fillRate, deviation: r.deviation, events: (r.events || []).length
    });
    if (scoreRoll.length > RECORD_KEEP) scoreRoll = scoreRoll.slice(0, RECORD_KEEP);
    saveLocal();
    renderScoreRoll();
    renderLedger();
    pushStats();
  }

  function renderHistorySearch() {
    const input = document.getElementById('historySearchInput');
    const resultDiv = document.getElementById('historyResult');
    if (!input || !resultDiv) return;
    const keyword = input.value.trim().toLowerCase();
    if (!keyword) { resultDiv.innerHTML = '<span style="color:#888;">请输入用户名查询</span>'; return; }
    const filtered = scoreRoll.filter(item => item.user.toLowerCase().includes(keyword));
    if (filtered.length === 0) { resultDiv.innerHTML = '<span style="color:#ff8866;">未找到相关记录</span>'; return; }
    resultDiv.innerHTML = '<div class="score-roll" style="max-height:150px;">' +
      filtered.slice(0, 20).map(item =>
        '<div class="score-roll-item"><span class="user">'+item.user+'</span><span class="score">'+item.score+'分</span></div>'
      ).join('') + '</div>';
  }

  function downloadExcel() {
    const rows = scoreRoll.slice(0, LEDGER_ROWS);
    if (rows.length === 0) { alert('暂无成绩数据'); return; }
    const data = rows.map((item, idx) => ({
      '序号': idx + 1, '用户名': item.user, '总分': item.score,
      '采购成本得分': item.proc, '物流成本得分': item.log,
      '市场满足得分': item.fill, '生产满足得分': item.prod, '预测偏差得分': item.dev,
      '市场满足率': item.fillRate !== undefined ? item.fillRate + '%' : '-',
      '预测偏差率': item.deviation !== undefined ? item.deviation + '%' : '-',
      '风险事件应对数': item.events !== undefined ? item.events : '-',
      '完成时间': fmtTime(item.time)
    }));
    const wb = XLSX.utils.book_new();
    const ws = XLSX.utils.json_to_sheet(data);
    ws['!cols'] = [{ wch: 6 }, { wch: 14 }, { wch: 8 }, { wch: 12 }, { wch: 12 }, { wch: 12 }, { wch: 12 }, { wch: 12 }, { wch: 12 }, { wch: 12 }, { wch: 10 }, { wch: 20 }];
    XLSX.utils.book_append_sheet(wb, ws, '实验成绩台账');

    const stat = [
      { '指标': '累计参与实验(人次)', '数值': participantTotal() },
      { '指标': '基线人数', '数值': PARTICIPANT_BASE },
      { '指标': '后期登录次数', '数值': totalLogins },
      { '指标': '每次登录登记倍数', '数值': LOGIN_INCREMENT },
      { '指标': '台账展示条数', '数值': LEDGER_ROWS },
      { '指标': '累计成绩记录数', '数值': scoreRoll.length },
      { '指标': '服务端同步状态', '数值': apiOnline ? '已启用(跨浏览器累计)' : '未启用(仅本地浏览器存储)' },
      { '指标': '导出时间', '数值': fmtTime(Date.now()) }
    ];
    const ws2 = XLSX.utils.json_to_sheet(stat);
    ws2['!cols'] = [{ wch: 24 }, { wch: 32 }];
    XLSX.utils.book_append_sheet(wb, ws2, '平台统计');

    XLSX.writeFile(wb, 'HF锂离子蓄电池_实验成绩台账.xlsx');
    notify('成绩台账Excel导出成功（' + rows.length + '条）！');
  }

  window._nav = navigateToStep;
  window.selectBid = function(el, idx) {
    state.bidStrategy = idx;
    document.querySelectorAll('[onclick^="selectBid"]').forEach(c => { c.style.borderColor = ''; c.style.background=''; });
    el.style.borderColor = '#2980d9'; el.style.background = '#eef4fb';
    toast('已选择' + ['保守','均衡','激进'][idx] + '投标策略');
  };
  window.selectLoan = function(el, days) {
    state.loanChoice = days;
    document.querySelectorAll('[onclick^="selectLoan"]').forEach(c => { c.style.borderColor=''; c.style.background=''; });
    el.style.borderColor='#2980d9'; el.style.background='#eef4fb';
    toast('已选择' + days + '天期贷款');
  };
  window.toggleUpgrade = function(el) {
    state.factoryUpgrade = !state.factoryUpgrade;
    el.style.borderColor = state.factoryUpgrade ? '#2980d9' : '';
    el.style.background = state.factoryUpgrade ? '#eef4fb' : '';
    toast(state.factoryUpgrade ? '已选择扩建苏州工厂（产能+20%，投资800万）' : '已取消工厂扩建');
  };
  updateStepUI();

  // ========== 全局3D背景（供应链主题：工厂+集装箱+物流节点） ==========
  (function initGlobal3D() {
    const container = document.getElementById('three-container');
    if (!container) return;
    if (typeof THREE === 'undefined' || !THREE) {
      container.style.background = 'linear-gradient(160deg,#060f22,#0a1a33 60%,#0d2440)';
      return;
    }
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x060a14);
    scene.fog = new THREE.Fog(0x060a14, 15, 40);
    const camera = new THREE.PerspectiveCamera(55, window.innerWidth/window.innerHeight, 0.1, 100);
    camera.position.set(0, 4, 14);
    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });
    renderer.setSize(window.innerWidth, window.innerHeight);
    container.appendChild(renderer.domElement);

    scene.add(new THREE.AmbientLight(0x304060, 0.6));
    const mainLight = new THREE.DirectionalLight(0x88bbff, 0.8);
    mainLight.position.set(5, 10, 5);
    scene.add(mainLight);
    const accentLight = new THREE.PointLight(0x00d2ff, 0.5, 30);
    accentLight.position.set(-5, 3, -5);
    scene.add(accentLight);

    // 地面
    const groundGeo = new THREE.PlaneGeometry(60, 60);
    const groundMat = new THREE.MeshStandardMaterial({ color: 0x0a1525, roughness: 0.9 });
    const ground = new THREE.Mesh(groundGeo, groundMat);
    ground.rotation.x = -Math.PI/2;
    ground.position.y = -2;
    scene.add(ground);

    // 仓库建筑（简化盒体）
    const warehouseGeo = new THREE.BoxGeometry(3, 1.5, 2);
    const warehouseMat = new THREE.MeshStandardMaterial({ color: 0x1a3a5a, roughness: 0.7, metalness: 0.3 });
    const warehouses = [
      [-6, -1.2, -3], [6, -1.2, -2], [-4, -1.2, 4], [5, -1.2, 5]
    ];
    warehouses.forEach(pos => {
      const w = new THREE.Mesh(warehouseGeo, warehouseMat);
      w.position.set(pos[0], pos[1], pos[2]);
      scene.add(w);
    });

    // 集装箱
    const containerGeo = new THREE.BoxGeometry(0.8, 0.5, 0.5);
    const containerColors = [0x00d2ff, 0xffaa44, 0x00ff88, 0xff6688];
    for (let i = 0; i < 20; i++) {
      const mat = new THREE.MeshStandardMaterial({
        color: containerColors[i % 4], roughness: 0.5, metalness: 0.4
      });
      const c = new THREE.Mesh(containerGeo, mat);
      c.position.set((Math.random()-0.5)*16, -1.5 + Math.random()*0.3, (Math.random()-0.5)*16);
      c.rotation.y = Math.random() * Math.PI;
      scene.add(c);
    }

    // 运输线路（发光线条）
    const linePoints = [
      new THREE.Vector3(-6, -1, -3), new THREE.Vector3(0, -1, 0),
      new THREE.Vector3(6, -1, -2), new THREE.Vector3(0, -1, 0),
      new THREE.Vector3(-4, -1, 4), new THREE.Vector3(0, -1, 0),
      new THREE.Vector3(5, -1, 5), new THREE.Vector3(0, -1, 0)
    ];
    const lineGeo = new THREE.BufferGeometry().setFromPoints(linePoints);
    const lineMat = new THREE.LineBasicMaterial({ color: 0x00d2ff, transparent: true, opacity: 0.3 });
    scene.add(new THREE.LineSegments(lineGeo, lineMat));

    // 中心能量球
    const core = new THREE.Mesh(
      new THREE.SphereGeometry(0.6, 32, 32),
      new THREE.MeshStandardMaterial({ color: 0x00d2ff, emissive: 0x0088aa, emissiveIntensity: 0.6, roughness: 0.2, metalness: 0.7 })
    );
    core.position.set(0, 0, 0);
    scene.add(core);

    // 粒子系统
    const particles = new THREE.BufferGeometry();
    const pos = new Float32Array(500 * 3);
    for (let i = 0; i < 500*3; i++) pos[i] = (Math.random()-0.5)*30;
    particles.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    const pMat = new THREE.PointsMaterial({ color: 0x4488ff, size: 0.05, transparent: true, opacity: 0.4, blending: THREE.AdditiveBlending });
    scene.add(new THREE.Points(particles, pMat));

    // 自动旋转相机
    let angle = 0;
    function animate() {
      requestAnimationFrame(animate);
      angle += 0.0015;
      camera.position.x = Math.sin(angle) * 14;
      camera.position.z = Math.cos(angle) * 14;
      camera.position.y = 4;
      camera.lookAt(0, 0, 0);
      core.rotation.y += 0.01;
      renderer.render(scene, camera);
    }
    animate();

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth/window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });
  })();

})();
</script>
</body>
</html>
