  // DOM引用
  const loginScreen = document.getElementById('loginScreen');
  const mainWrapper = document.getElementById('mainWrapper');
  const stepContent = document.getElementById('stepContent');
  const stepBtns = document.querySelectorAll('.step-btn');

  function notify(msg) {
    const n = document.createElement('div'); n.className = 'notification';
    n.innerHTML = '<i class="fas fa-check-circle"></i> ' + msg;
    document.body.appendChild(n);
    setTimeout(() => n.remove(), 2800);
  }

  // ===== Toast通知 =====
  function toast(msg, type) {
    const zone = document.getElementById('toastZone'); if (!zone) return;
    const t = document.createElement('div');
    t.className = 'toast ' + (type || 'ok');
    const icon = type === 'err' ? 'fa-times-circle' : type === 'warn' ? 'fa-exclamation-triangle' : 'fa-check-circle';
    t.innerHTML = '<i class="fas ' + icon + '" style="color:var(--theme,#2980d9);margin-right:.5rem;"></i>' + msg;
    zone.appendChild(t);
    setTimeout(() => { t.classList.add('out'); setTimeout(() => t.remove(), 350); }, 3000);
  }

  // ===== 彩带庆祝 =====
  function fireConfetti() {
    const c = document.getElementById('confetti'); if (!c) return;
    c.style.display = 'block';
    const ctx = c.getContext('2d');
    c.width = innerWidth; c.height = innerHeight;
    const pieces = [];
    const colors = ['#e74c3c','#f39c12','#2ecc71','#3498db','#9b59b6','#1abc9c'];
    for (let i = 0; i < 150; i++) {
      pieces.push({ x: Math.random()*c.width, y: -20, w: 8+Math.random()*6, h: 12+Math.random()*8,
        color: colors[Math.floor(Math.random()*colors.length)], vy: 2+Math.random()*3, vx: -1+Math.random()*2, rot: Math.random()*360, vr: -3+Math.random()*6 });
    }
    function frame() {
      ctx.clearRect(0,0,c.width,c.height);
      let alive = false;
      pieces.forEach(p => {
        p.y += p.vy; p.x += p.vx; p.rot += p.vr;
        if (p.y < c.height + 20) alive = true;
        ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.rot*Math.PI/180);
        ctx.fillStyle = p.color; ctx.fillRect(-p.w/2, -p.h/2, p.w, p.h); ctx.restore();
      });
      if (alive) requestAnimationFrame(frame); else { c.style.display = 'none'; ctx.clearRect(0,0,c.width,c.height); }
    }
    frame();
  }

  // ===== 风险事件 =====
  const RISK_EVENTS = [
    { day: 8, title: '电芯供应商限产', desc: '石家庄电芯厂因设备检修，本周期电芯供应量减少30%。你如何应对？',
