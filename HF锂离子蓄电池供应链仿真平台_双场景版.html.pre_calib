                {text:'紧急调货国内转口', logMult:1.15, mktMult:0.97}] },
    { day: 52, title: '电池良品率下降', desc: '苏州PACK厂良品率从92%降至85%，需要额外返工。你如何应对？',
      choices: [{text:'增加质检成本保质量', outMult:0.95, costMult:1.06},
                {text:'勉强出货保数量', outMult:1.0, mktMult:0.92},
                {text:'停产整顿（延迟2天）', outMult:0.88, mktMult:0.95}] },
    { day: 25, title: '暴雪封路（V3.0新增）', desc: '北方暴雪导致公路中断3天，石家庄电芯厂发往广州PACK厂的原料运输受阻。你如何应对？',
      choices: [{text:'改走铁路快运（运费+15%）', logMult:1.15, outMult:0.98},
                {text:'等待雪融（延迟3天到货）', logMult:1.0, outMult:0.88},
                {text:'启用宝鸡备用供应商直供', logMult:1.05, outMult:0.95}] },
    { day: 35, title: '油价上涨（V3.0新增）', desc: '国际油价单日上涨12%，汽运和海运成本同步上升。你如何应对？',
      choices: [{text:'已签订长期运输协议（成本不变）', logMult:1.0},
                {text:'改用铁路多式联运（时间+2天）', logMult:1.05},
                {text:'承担油价上涨成本', logMult:1.12}] }
  ].sort((a, b) => a.day - b.day);
  let eventResults = [];
  function showEventModal(ev, cb) {
    // 移除已有弹窗
    var old = document.getElementById('__risk_modal__'); if(old) old.remove();
    // 先隐藏3D画布和主内容，避免遮挡
    var tc = document.getElementById('three-container'); if(tc) tc.style.display='none';
    setTimeout(function(){
      var modal = document.createElement('div');
      modal.id = '__risk_modal__';
      modal.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;width:100vw;height:100vh;background:rgba(0,0,0,0.7);z-index:2147483647;display:flex !important;align-items:center;justify-content:center;margin:0;padding:0;';
      var box = document.createElement('div');
      box.style.cssText = 'background:#fff;border-radius:1rem;padding:2rem;max-width:500px;width:90%;box-shadow:0 20px 60px rgba(0,0,0,0.5);border-top:4px solid #e74c3c;';
      box.innerHTML = '<h3 style="color:#e74c3c;margin-bottom:0.8rem;font-size:1.2rem;"><i class="fas fa-exclamation-triangle"></i> Day '+ev.day+'：'+ev.title+'</h3>' +
        '<p style="color:#2c3e50;line-height:1.7;margin-bottom:1rem;">'+ev.desc+'</p><div class="ev-choices" style="display:flex;flex-direction:column;gap:0.6rem;"></div>';
      ev.choices.forEach(function(ch){
        var btn = document.createElement('button');
        btn.style.cssText = 'background:#f8fafc;border:2px solid #dce4ec;border-radius:0.6rem;padding:0.8rem 1rem;cursor:pointer;text-align:left;color:#2c3e50;font-size:0.9rem;';
        btn.textContent = ch.text;
        btn.onmouseenter = function(){ this.style.borderColor='#2980d9'; this.style.background='#eef4fb'; };
        btn.onmouseleave = function(){ this.style.borderColor='#dce4ec'; this.style.background='#f8fafc'; };
        btn.onclick = function(){
          modal.remove();
          if(tc) tc.style.display='block';
          cb(ch);
        };
        box.querySelector('.ev-choices').appendChild(btn);
      });
      modal.appendChild(box);
      document.documentElement.appendChild(modal);
    }, 100);
  }

  // 登录事件
  document.getElementById('loginBtn').addEventListener('click', () => {
    const u = document.getElementById('username').value.trim();
    const p = document.getElementById('password').value.trim();
    if (u === 'HFAdmin' && p === 'supply2024') {
      totalLogins += 1;
      saveLocal();
      updateLoginDisplay();
      pushStats();
      state.loggedIn = true; state.completedSteps.add(1);
      document.getElementById('displayUser').textContent = u;
      loginScreen.style.display = 'none';
      mainWrapper.classList.add('active');
      navigateToStep(1);
      notify('登录成功 · 欢迎使用3D虚拟仿真平台');
    } else {
      alert('用户名或密码错误');
    }
  });

  stepBtns.forEach(btn => {
    btn.addEventListener('click', function() {
      if (!state.loggedIn) return;
      const step = parseInt(this.dataset.step);
      const maxReachable = Math.max(...Array.from(state.completedSteps), state.currentStep);
      if (step <= maxReachable + 1 || state.completedSteps.has(step)) {
        navigateToStep(step);
      } else {
        notify('请按顺序完成前面的步骤');
      }
    });
  });

  function completeStep(step) {
    state.completedSteps.add(step);
    updateStepUI();
  }

  function navigateToStep(step) {
    state.currentStep = step;
    // 切换步骤主题色
    document.body.className = '';
    document.body.classList.add('step-' + step);
    updateStepUI();
    renderStep(step);
    stepContent.scrollIntoView({ behavior: 'smooth' });
  }

  function updateStepUI() {
    stepBtns.forEach(btn => {
      const s = parseInt(btn.dataset.step);
      btn.classList.remove('active', 'completed');
      if (s === state.currentStep) btn.classList.add('active');
      if (state.completedSteps.has(s)) btn.classList.add('completed');
    });
  }

  // ========== 步骤渲染 ==========
  function renderStep(step) {
    let html = '';
    switch(step) {
      case 1:
        html = '<h2><i class="fas fa-check-circle" style="color:#00ff88;"></i> 欢迎进入实验平台</h2>' +
          '<div class="supply-hero">' +
            '<img src="assets/login-bg.jpg" alt="智能供应链全景">' +
